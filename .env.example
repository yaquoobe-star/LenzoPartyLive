# Custom Email OTP (Zero Resend) — Priority: 1) BREVO_API_KEY (HTTPS 443), 2) EMAIL_WEBHOOK_URL (HTTPS 443 Gmail Apps Script), 3) SMTP
# NOTE: Railway Trial/Hobby plans block outbound SMTP ports (25/465/587), so use EMAIL_WEBHOOK_URL or BREVO_API_KEY on Railway!
BREVO_API_KEY=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
EMAIL_FROM=Lenzo Party Live <no-reply@lenzoparty.com>
EMAIL_OTP_SECRET=

# Optional SMTP Fallback (works on Railway Pro, VPS, local dev, or SMTP port 2525)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web Push VAPID keys (optional: auto-generated and persisted if left blank)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
