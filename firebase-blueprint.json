{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered Linzo Party Live user profile stored in Firestore",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Authentication UID",
          "maxLength": 128
        },
        "fullName": {
          "type": "string",
          "description": "User's full display name",
          "minLength": 2,
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "description": "User's email address",
          "format": "email",
          "maxLength": 120
        },
        "profileImage": {
          "type": "string",
          "description": "URL or avatar path for user profile picture",
          "maxLength": 1000
        },
        "coverImage": {
          "type": "string",
          "description": "URL for user cover banner picture",
          "maxLength": 1000
        },
        "bio": {
          "type": "string",
          "description": "User profile biography",
          "maxLength": 300
        },
        "authProvider": {
          "type": "string",
          "description": "Authentication method used (google or password)",
          "enum": ["google", "password"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp or server timestamp string when user account was created"
        },
        "lastLogin": {
          "type": "string",
          "description": "ISO timestamp or server timestamp string of last login"
        },
        "isOnline": {
          "type": "boolean",
          "description": "Whether the user is currently online"
        },
        "followersCount": {
          "type": "number",
          "description": "Total followers count"
        },
        "followingCount": {
          "type": "number",
          "description": "Total following count"
        },
        "level": {
          "type": "number",
          "description": "User's gamified streaming level"
        },
        "coins": {
          "type": "number",
          "description": "Total coins in user balance"
        },
        "diamonds": {
          "type": "number",
          "description": "Total diamonds earned from gifts"
        },
        "vipLevel": {
          "type": "number",
          "description": "VIP tier level (1 to 5)"
        },
        "accountStatus": {
          "type": "string",
          "description": "Status of the user account",
          "enum": ["active", "suspended", "pending"]
        }
      },
      "required": ["uid", "fullName", "email", "authProvider", "accountStatus"]
    },
    "Post": {
      "title": "Post",
      "description": "User video post in the video feed",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of post creator",
          "maxLength": 128
        },
        "videoUrl": {
          "type": "string",
          "description": "Cloud Storage or CDN URL of the video",
          "maxLength": 1500
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "Cloud Storage URL of the video thumbnail",
          "maxLength": 1500
        },
        "description": {
          "type": "string",
          "description": "Caption or text description of the post",
          "maxLength": 500
        },
        "musicTitle": {
          "type": "string",
          "description": "Audio track or music name used in the video",
          "maxLength": 150
        },
        "likesCount": {
          "type": "number",
          "description": "Total likes count"
        },
        "commentsCount": {
          "type": "number",
          "description": "Total comments count"
        },
        "sharesCount": {
          "type": "number",
          "description": "Total shares count"
        },
        "isPrivate": {
          "type": "boolean",
          "description": "Whether the video is private to creator"
        }
      },
      "required": ["userId", "videoUrl"]
    },
    "PartyRoom": {
      "title": "PartyRoom",
      "description": "Active audio party room session",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Room title",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Room category (Music, Gaming, Chill, etc.)",
          "maxLength": 50
        },
        "maxSeats": {
          "type": "number",
          "description": "Total stage seats capacity (8, 12, or 16)"
        },
        "isLocked": {
          "type": "boolean",
          "description": "Whether seats are locked"
        },
        "allowJoin": {
          "type": "boolean",
          "description": "Whether listeners can request stage seats"
        },
        "announcement": {
          "type": "string",
          "description": "Room announcement message",
          "maxLength": 500
        }
      },
      "required": ["title", "category", "maxSeats"]
    },
    "LiveStream": {
      "title": "LiveStream",
      "description": "Solo real-time live broadcasting stream",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Live stream title",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Stream category",
          "maxLength": 50
        },
        "viewersCount": {
          "type": "number",
          "description": "Live audience count"
        },
        "likesCount": {
          "type": "number",
          "description": "Total hearts received"
        }
      },
      "required": ["title", "category"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Wallet coin recharge or gift transaction",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the user who performed transaction",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "description": "Type of transaction",
          "enum": ["recharge", "gift_sent", "gift_received", "reward"]
        },
        "amount": {
          "type": "number",
          "description": "Real currency amount or coin value"
        },
        "coinsChange": {
          "type": "number",
          "description": "Coins added (+) or deducted (-)"
        },
        "description": {
          "type": "string",
          "description": "Transaction description",
          "maxLength": 200
        }
      },
      "required": ["userId", "type", "coinsChange"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app push or event notification",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Notification headline",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "description": "Notification body message",
          "maxLength": 300
        },
        "type": {
          "type": "string",
          "description": "Notification category",
          "enum": ["system", "like", "follow", "gift"]
        },
        "isRead": {
          "type": "boolean",
          "description": "Whether notification has been opened"
        }
      },
      "required": ["title", "message", "type"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Direct message in a 1-on-1 chat",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "description": "UID of sender",
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "description": "Message text content",
          "maxLength": 1000
        }
      },
      "required": ["senderId", "text"]
    },
    "UserWallet": {
      "title": "UserWallet",
      "description": "User purchased coins wallet balance",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "walletPurchasedCoins": { "type": "number" },
        "totalCoinsPurchased": { "type": "number" },
        "totalCoinsSpent": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "walletPurchasedCoins"]
    },
    "UserEarnings": {
      "title": "UserEarnings",
      "description": "User net earnings from received virtual gifts",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "availableEarningsCoins": { "type": "number" },
        "pendingWithdrawalCoins": { "type": "number" },
        "totalWithdrawnCoins": { "type": "number" },
        "grossGiftCoinsReceived": { "type": "number" },
        "totalCommissionDeducted": { "type": "number" },
        "totalConvertedToWallet": { "type": "number" },
        "totalGiftsCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "availableEarningsCoins"]
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "Payout request submitted by a creator",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 60 },
        "coinsRequested": { "type": "number" },
        "exchangeRatePkr": { "type": "number" },
        "grossAmountPkr": { "type": "number" },
        "feeAmountPkr": { "type": "number" },
        "finalPayablePkr": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["bank_transfer", "jazzcash", "easypaisa", "cash_pickup"] },
        "status": { "type": "string", "enum": ["pending", "under_review", "approved", "processing", "paid", "rejected", "cancelled"] },
        "requestedAt": { "type": "string" }
      },
      "required": ["userId", "coinsRequested", "paymentMethod", "status"]
    },
    "UserLevelProgression": {
      "title": "UserLevelProgression",
      "description": "50-Level and 8-tier VIP progression state based on qualifying coins spent on gifting",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "currentLevel": { "type": "number", "minimum": 1, "maximum": 50 },
        "currentTier": { "type": "string", "enum": ["Bronze", "Silver", "Gold", "Platinum", "Diamond"] },
        "totalQualifyingCoinsSpent": { "type": "number" },
        "coinsInCurrentLevel": { "type": "number" },
        "coinsNeededForNextLevel": { "type": "number" },
        "remainingCoinsNeeded": { "type": "number" },
        "percentage": { "type": "number" },
        "unlockedVipFrames": { "type": "array", "items": { "type": "number" } },
        "equippedVipFrame": { "type": "number" }
      },
      "required": ["userId", "currentLevel", "currentTier", "totalQualifyingCoinsSpent"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator identity document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "super_admin"] }
      },
      "required": ["uid", "email", "role"]
    },
    "ChatGroup": {
      "title": "ChatGroup",
      "description": "Community group conversation metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "privacy": { "type": "string", "enum": ["public", "private"] }
      },
      "required": ["name", "creatorId"]
    },
    "WalletSettings": {
      "title": "WalletSettings",
      "description": "Global platform commission, exchange rate, and withdrawal limit configuration",
      "type": "object",
      "properties": {
        "commissionRatePercent": { "type": "number" },
        "exchangeRatePkrPerCoin": { "type": "number" },
        "minWithdrawalCoins": { "type": "number" },
        "maxWithdrawalCoins": { "type": "number" },
        "withdrawalFeePercent": { "type": "number" }
      },
      "required": ["commissionRatePercent", "exchangeRatePkrPerCoin", "minWithdrawalCoins", "maxWithdrawalCoins"]
    },
    "CoinPackage": {
      "title": "CoinPackage",
      "description": "Coin recharge package catalog entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "coins": { "type": "number" },
        "bonusCoins": { "type": "number" },
        "pricePkr": { "type": "number" },
        "enabled": { "type": "boolean" }
      },
      "required": ["id", "coins", "pricePkr", "enabled"]
    },
    "CommissionTransaction": {
      "title": "CommissionTransaction",
      "description": "Platform commission audit record created on gift transfers",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "maxLength": 128 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "grossCost": { "type": "number" },
        "commissionCoins": { "type": "number" },
        "netEarningsCoins": { "type": "number" }
      },
      "required": ["senderId", "recipientId", "grossCost", "commissionCoins"]
    },
    "LiveComment": {
      "title": "LiveComment",
      "description": "Real-time live stream comment message",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 80 },
        "senderAvatar": { "type": "string", "maxLength": 1000 },
        "text": { "type": "string", "maxLength": 500 },
        "level": { "type": "number" },
        "type": { "type": "string", "enum": ["chat", "gift", "system"] },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "text"]
    },
    "LiveViewer": {
      "title": "LiveViewer",
      "description": "Active viewer inside a live stream session",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 80 },
        "username": { "type": "string", "maxLength": 60 },
        "avatar": { "type": "string", "maxLength": 1000 },
        "level": { "type": "number" },
        "joinedAt": { "type": "string" },
        "lastHeartbeatAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "Real-time party room chat message",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 80 },
        "text": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["chat", "gift", "system"] },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "text"]
    },
    "RoomParticipant": {
      "title": "RoomParticipant",
      "description": "Active participant in an audio party room",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 80 },
        "avatar": { "type": "string", "maxLength": 1000 },
        "level": { "type": "number" },
        "seatIndex": { "type": "number" },
        "isMuted": { "type": "boolean" },
        "joinedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "FollowRelation": {
      "title": "FollowRelation",
      "description": "User follower-following edge document",
      "type": "object",
      "properties": {
        "followerId": { "type": "string", "maxLength": 128 },
        "followingId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["followerId", "followingId"]
    },
    "RankingConfig": {
      "title": "RankingConfig",
      "description": "Configurable weights for the TOP 1 & TOP 2 broadcaster ranking engine",
      "type": "object",
      "properties": {
        "viewerWeight": { "type": "number" },
        "giftWeight": { "type": "number" },
        "engagementWeight": { "type": "number" },
        "durationWeight": { "type": "number" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string", "maxLength": 120 }
      },
      "required": ["viewerWeight", "giftWeight", "engagementWeight", "durationWeight"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": "AdminUser",
      "description": "Stores verified platform administrators keyed by Firebase Auth UID"
    },
    "/users/{uid}": {
      "schema": "User",
      "description": "Stores user profiles keyed by their Firebase Auth UID"
    },
    "/user_levels/{uid}": {
      "schema": "UserLevelProgression",
      "description": "Stores 50-Level and 8-tier VIP progression documents"
    },
    "/level_configurations/{docId}": {
      "schema": "UserLevelProgression",
      "description": "Stores admin level milestone configuration"
    },
    "/vip_frames/{docId}": {
      "schema": "UserLevelProgression",
      "description": "Stores admin VIP frame definitions"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "User uploaded videos and posts"
    },
    "/party_rooms/{roomId}": {
      "schema": "PartyRoom",
      "description": "Active audio party rooms"
    },
    "/party_rooms/{roomId}/messages/{messageId}": {
      "schema": "RoomMessage",
      "description": "Real-time party room chat messages"
    },
    "/party_rooms/{roomId}/participants/{participantId}": {
      "schema": "RoomParticipant",
      "description": "Active listeners and seated speakers inside a party room"
    },
    "/live_streams/{streamId}": {
      "schema": "LiveStream",
      "description": "Active live video streams"
    },
    "/live_streams/{streamId}/comments/{commentId}": {
      "schema": "LiveComment",
      "description": "Real-time comments inside a live stream"
    },
    "/live_streams/{streamId}/viewers/{viewerId}": {
      "schema": "LiveViewer",
      "description": "Active live stream viewers"
    },
    "/follows/{followId}": {
      "schema": "FollowRelation",
      "description": "Follower-following relationships"
    },
    "/ranking_configs/{configId}": {
      "schema": "RankingConfig",
      "description": "Admin-configurable broadcaster ranking weights"
    },
    "/wallets/{uid}": {
      "schema": "UserWallet",
      "description": "User purchased coins wallet balance"
    },
    "/earnings/{uid}": {
      "schema": "UserEarnings",
      "description": "User net earnings from received virtual gifts"
    },
    "/wallet_transactions/{txId}": {
      "schema": "Transaction",
      "description": "Wallet coins transaction history"
    },
    "/earnings_transactions/{txId}": {
      "schema": "Transaction",
      "description": "Earnings and payout transaction history"
    },
    "/commission_transactions/{txId}": {
      "schema": "CommissionTransaction",
      "description": "Platform commission audit log for virtual gifts"
    },
    "/withdrawal_requests/{reqId}": {
      "schema": "WithdrawalRequest",
      "description": "Creator withdrawal and payout requests"
    },
    "/wallet_settings/{settingId}": {
      "schema": "WalletSettings",
      "description": "Global wallet commission, PKR conversion rate, and withdrawal limit configuration"
    },
    "/coin_packages/{pkgId}": {
      "schema": "CoinPackage",
      "description": "Recharge coin package catalog"
    },
    "/groups/{groupId}": {
      "schema": "ChatGroup",
      "description": "Community chat groups"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Direct chat conversation messages"
    }
  }
}

