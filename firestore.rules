rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================================
    // GLOBAL SECURITY PRIMITIVES
    // ========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email.lower() == 'saifkhokhar657@gmail.com'
          || request.auth.token.email.lower() == 'lenzopartyofficial@gmail.com'
        );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBlockedBy(blockerUid, targetUid) {
      return blockerUid is string
        && targetUid is string
        && exists(/databases/$(database)/documents/blocked_users/$(blockerUid + '_' + targetUid));
    }

    function isKickedFromRoom(roomId, uid) {
      return roomId is string
        && uid is string
        && exists(/databases/$(database)/documents/room_kicks/$(roomId + '_' + uid))
        && (
          get(/databases/$(database)/documents/room_kicks/$(roomId + '_' + uid)).data.durationType == 'session'
          || (
            'expiresAt' in get(/databases/$(database)/documents/room_kicks/$(roomId + '_' + uid)).data
            && get(/databases/$(database)/documents/room_kicks/$(roomId + '_' + uid)).data.expiresAt is number
            && get(/databases/$(database)/documents/room_kicks/$(roomId + '_' + uid)).data.expiresAt > request.time.toMillis()
          )
        );
    }

    function isHostModerator(hostUid, candidateUid) {
      return hostUid is string
        && candidateUid is string
        && exists(/databases/$(database)/documents/host_moderators/$(hostUid + '_' + candidateUid));
    }

    function isActiveCoinSellerOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/agencies/$('cs_' + request.auth.uid))
        && get(/databases/$(database)/documents/agencies/$('cs_' + request.auth.uid)).data.agencyType == 'coin_seller'
        && get(/databases/$(database)/documents/agencies/$('cs_' + request.auth.uid)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/agencies/$('cs_' + request.auth.uid)).data.status == 'active';
    }

    function isVerifiedCoinSellerAgencyTransfer(coinDelta) {
      return isActiveCoinSellerOwner()
        && coinDelta is number
        && coinDelta > 0
        && get(/databases/$(database)/documents/agencies/$('cs_' + request.auth.uid)).data.coinBalance is number
        && getAfter(/databases/$(database)/documents/agencies/$('cs_' + request.auth.uid)).data.coinBalance is number
        && getAfter(/databases/$(database)/documents/agencies/$('cs_' + request.auth.uid)).data.coinBalance >= 0
        && getAfter(/databases/$(database)/documents/agencies/$('cs_' + request.auth.uid)).data.coinBalance
           < get(/databases/$(database)/documents/agencies/$('cs_' + request.auth.uid)).data.coinBalance
        && coinDelta
           == (get(/databases/$(database)/documents/agencies/$('cs_' + request.auth.uid)).data.coinBalance
               - getAfter(/databases/$(database)/documents/agencies/$('cs_' + request.auth.uid)).data.coinBalance);
    }

    // ========================================================
    // 0. ADMINS COLLECTION (/admins/{uid})
    // ========================================================
    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ========================================================
    // 1. USERS COLLECTION (/users/{uid})
    // ========================================================
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'authProvider', 'accountStatus'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 60
        && data.email is string && data.email.size() <= 120
        && data.authProvider in ['google', 'password']
        && data.accountStatus in ['active', 'suspended', 'pending', 'blocked']
        && (!('username' in data) || (data.username is string && data.username.size() <= 40))
        && (!('displayId' in data) || (data.displayId is string && data.displayId.size() <= 32))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && (!('lastActiveAt' in data) || (data.lastActiveAt is string && data.lastActiveAt.size() <= 64))
        && (!('providerIds' in data) || (data.providerIds is list && data.providerIds.size() <= 6))
        && (!('profileImage' in data) || (data.profileImage is string && data.profileImage.size() <= 1500))
        && (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 1500))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && (!('gender' in data) || (data.gender is string && data.gender.size() <= 24))
        && (!('country' in data) || (data.country is string && data.country.size() <= 64))
        && (!('birthday' in data) || (data.birthday is string && data.birthday.size() <= 32))
        && (!('followersCount' in data) || (data.followersCount is number && data.followersCount >= 0))
        && (!('followingCount' in data) || (data.followingCount is number && data.followingCount >= 0))
        && (!('level' in data) || (data.level is number && data.level >= 0 && data.level <= 100))
        && (!('coins' in data) || (data.coins is number && data.coins >= 0))
        && (!('diamonds' in data) || (data.diamonds is number && data.diamonds >= 0))
        && (!('totalQualifyingCoinsSpent' in data) || (data.totalQualifyingCoinsSpent is number && data.totalQualifyingCoinsSpent >= 0 && data.totalQualifyingCoinsSpent <= 2000000000))
        && (!('vipLevel' in data) || (data.vipLevel is number && data.vipLevel >= 0 && data.vipLevel <= 12))
        && (!('superVipLevel' in data) || (data.superVipLevel is number && data.superVipLevel >= 0 && data.superVipLevel <= 6))
        && (!('equippedVipFrame' in data) || (data.equippedVipFrame is number && data.equippedVipFrame >= 0 && data.equippedVipFrame <= 12))
        && (!('equippedSuperVipFrame' in data) || (data.equippedSuperVipFrame is number && data.equippedSuperVipFrame >= 0 && data.equippedSuperVipFrame <= 6))
        && (!('activeFrameType' in data) || data.activeFrameType in ['none', 'vip', 'super_vip'])
        && (!('equippedBadges' in data) || (data.equippedBadges is list && data.equippedBadges.size() <= 3))
        && (!('isVIP' in data) || data.isVIP is bool)
        && (!('isSuperVIP' in data) || data.isSuperVIP is bool)
        && (!('isAdmin' in data) || data.isAdmin is bool)
        && (!('isVerified' in data) || data.isVerified is bool)
        && (!('verificationTier' in data) || data.verificationTier in ['none', 'blue', 'gold'])
        && (!('verifiedTag' in data) || (data.verifiedTag is string && data.verifiedTag.size() <= 32))
        && (!('isBlocked' in data) || data.isBlocked is bool)
        && (!('blockReason' in data) || (data.blockReason is string && data.blockReason.size() <= 300))
        && (!('blockedAt' in data) || (data.blockedAt is string && data.blockedAt.size() <= 64))
        && (!('blockedBy' in data) || (data.blockedBy is string && data.blockedBy.size() <= 120))
        && (!('suspendedUntil' in data) || (data.suspendedUntil is number && data.suspendedUntil >= 0))
        && (!('suspendReason' in data) || (data.suspendReason is string && data.suspendReason.size() <= 300))
        && (!('suspendedAt' in data) || (data.suspendedAt is string && data.suspendedAt.size() <= 64))
        && (!('suspendedBy' in data) || (data.suspendedBy is string && data.suspendedBy.size() <= 120))
        && (!('isDeviceBanned' in data) || data.isDeviceBanned is bool)
        && (!('lastDeviceId' in data) || (data.lastDeviceId is string && data.lastDeviceId.size() <= 128))
        && (!('lastDeviceInfo' in data) || (data.lastDeviceInfo is string && data.lastDeviceInfo.size() <= 200))
        && (!('isOnline' in data) || data.isOnline is bool);
    }

    function hasNoSelfGrantedPrivileges(data) {
      return (!('isAdmin' in data) || data.isAdmin == false)
        && (!('isVerified' in data) || data.isVerified == false)
        && (!('verificationTier' in data) || data.verificationTier == 'none')
        && (!('verifiedTag' in data) || data.verifiedTag == '');
    }

    function isValidOwnerCoinUpdate(beforeData, afterData) {
      return !afterData.diff(beforeData).affectedKeys().hasAny(['coins'])
        || (
          afterData.coins is number
          && (
            ('coins' in beforeData && afterData.coins <= beforeData.coins)
            || (!('coins' in beforeData) && afterData.coins == 0)
            || (
              'diamonds' in beforeData
              && 'diamonds' in afterData
              && beforeData.diamonds is number
              && afterData.diamonds is number
              && afterData.diamonds < beforeData.diamonds
              && (afterData.coins - (('coins' in beforeData && beforeData.coins is number) ? beforeData.coins : 0))
                 <= (beforeData.diamonds - afterData.diamonds)
            )
          )
        );
    }

    match /users/{uid} {
      // Authenticated users can view creator profiles; list restricted to owner, active coin seller agency (for recipient lookup), or admin
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin() || isActiveCoinSellerOwner());

      // Only the authenticated user can create their own profile document without privileged flags or preloaded coins
      allow create: if isOwner(uid)
                    && isValidId(uid)
                    && incoming().uid == request.auth.uid
                    && incoming().accountStatus == 'active'
                    && isValidUser(incoming())
                    && (
                      isAdmin()
                      || (
                        hasNoSelfGrantedPrivileges(incoming())
                        && (!('coins' in incoming()) || incoming().coins == 0)
                      )
                    );

      // Action-partitioned updates:
      // 1) Owner updating their own profile with immutable core identity, privileged fields & non-self-creditable coins
      // 2) Authenticated gifter crediting recipient's diamonds balance upward only
      // 3) Verified active Coin Seller Agency crediting recipient's coins atomically against its own deducted agency coinBalance
      // 4) Admin override
      allow update: if isSignedIn() && isValidId(uid) && isValidUser(incoming()) && (
                      isAdmin()
                      || (
                        isOwner(uid)
                        && isValidOwnerCoinUpdate(existing(), incoming())
                        && !incoming().diff(existing()).affectedKeys().hasAny([
                          'uid',
                          'email',
                          'authProvider',
                          'accountStatus',
                          'isAdmin',
                          'isVerified',
                          'verificationTier',
                          'verifiedTag',
                          'isBlocked',
                          'blockReason',
                          'blockedAt',
                          'blockedBy',
                          'suspendedUntil',
                          'suspendReason',
                          'suspendedAt',
                          'suspendedBy',
                          'isDeviceBanned'
                        ])
                      )
                      || (
                        incoming().diff(existing()).affectedKeys().hasOnly(['diamonds'])
                        && incoming().diamonds is number
                        && (!('diamonds' in existing()) || incoming().diamonds >= existing().diamonds)
                      )
                      || (
                        incoming().diff(existing()).affectedKeys().hasOnly(['coins'])
                        && incoming().coins is number
                        && isVerifiedCoinSellerAgencyTransfer(
                          incoming().coins - (('coins' in existing() && existing().coins is number) ? existing().coins : 0)
                        )
                      )
                    );

      allow delete: if false;

      // User Transactions subcollection
      match /transactions/{transactionId} {
        allow get: if (isOwner(uid) || isAdmin()) && isValidId(transactionId);
        allow list: if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) || isAdmin())
                      && isValidId(transactionId)
                      && incoming().userId == uid;
        allow update, delete: if false;
      }

      // User Notifications subcollection
      match /notifications/{notificationId} {
        allow get: if (isOwner(uid) || isAdmin()) && isValidId(notificationId);
        allow list: if isOwner(uid) || isAdmin();
        allow create: if isSignedIn()
                      && isValidId(notificationId)
                      && incoming().title is string && incoming().title.size() <= 120
                      && incoming().message is string && incoming().message.size() <= 400
                      && incoming().type in ['system', 'like', 'follow', 'gift']
                      && incoming().isRead == false;
        allow update: if (isOwner(uid) || isAdmin())
                      && isValidId(notificationId)
                      && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
                      && incoming().isRead is bool;
        allow delete: if (isOwner(uid) || isAdmin()) && isValidId(notificationId);
      }
    }

    // ========================================================
    // 2. POSTS / VIDEOS COLLECTION (/posts/{postId})
    // ========================================================
    function isValidPost(data) {
      return data.keys().hasAll(['userId', 'videoUrl'])
        && data.userId is string && data.userId.size() <= 128
        && data.videoUrl is string && data.videoUrl.size() <= 1500
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1500))
        && (!('musicTitle' in data) || (data.musicTitle is string && data.musicTitle.size() <= 150))
        && (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0))
        && (!('sharesCount' in data) || (data.sharesCount is number && data.sharesCount >= 0))
        && (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0))
        && (!('isPrivate' in data) || data.isPrivate is bool);
    }

    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(postId)
                    && incoming().userId == request.auth.uid
                    && isValidPost(incoming());
      allow update: if isSignedIn()
                    && isValidId(postId)
                    && isValidPost(incoming())
                    && (
                      isAdmin()
                      || (existing().userId == request.auth.uid && incoming().userId == existing().userId)
                      || incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'sharesCount', 'commentsCount', 'viewsCount'])
                    );
      allow delete: if isSignedIn() && isValidId(postId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // ========================================================
    // 3. PARTY ROOMS COLLECTION (/party_rooms/{roomId})
    // ========================================================
    function getAuthoritativeHostLevel(hostUid) {
      return exists(/databases/$(database)/documents/user_levels/$(hostUid))
          && ('currentLevel' in get(/databases/$(database)/documents/user_levels/$(hostUid)).data)
          && (get(/databases/$(database)/documents/user_levels/$(hostUid)).data.currentLevel is number)
        ? get(/databases/$(database)/documents/user_levels/$(hostUid)).data.currentLevel
        : (
          exists(/databases/$(database)/documents/users/$(hostUid))
          && ('level' in get(/databases/$(database)/documents/users/$(hostUid)).data)
          && (get(/databases/$(database)/documents/users/$(hostUid)).data.level is number)
            ? get(/databases/$(database)/documents/users/$(hostUid)).data.level
            : 0
        );
    }

    function isValidPartyRoomSeatConfig(data, hostUid) {
      let hostLvl = getAuthoritativeHostLevel(hostUid);
      let validMaxSeats =
        data.maxSeats is number
        && (
          data.maxSeats == 5
          || (data.maxSeats == 8 && hostLvl >= 10)
          || (data.maxSeats == 16 && hostLvl >= 20)
        );
      let validSeatsList =
        !('seats' in data)
        || (
          data.seats is list
          && data.seats.size() <= data.maxSeats
          && (hostLvl >= 5 || data.seats.size() < 2 || data.seats[1] == null)
        );
      return validMaxSeats && validSeatsList;
    }

    function isValidGuestPartySeatUpdate(data, oldData) {
      let hostLvl = getAuthoritativeHostLevel(oldData.host.id);
      let maxCap = oldData.maxSeats is number ? oldData.maxSeats : 5;
      return !('seats' in data)
        || (
          data.seats is list
          && data.seats.size() <= maxCap
          && (hostLvl >= 5 || data.seats.size() < 2 || data.seats[1] == null)
        );
    }

    match /party_rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(roomId)
                    && incoming().host.id == request.auth.uid
                    && (!('seatTheme' in incoming()) || incoming().seatTheme in ['default', 'gold', 'green'])
                    && isValidPartyRoomSeatConfig(incoming(), request.auth.uid);
      allow update: if isSignedIn()
                    && isValidId(roomId)
                    && (!('seatTheme' in incoming()) || incoming().seatTheme in ['default', 'gold', 'green'])
                    && (
                      isAdmin()
                      || (
                        existing().host.id == request.auth.uid
                        && incoming().host.id == existing().host.id
                        && (
                          !incoming().diff(existing()).affectedKeys().hasAny(['maxSeats', 'seats'])
                          || isValidPartyRoomSeatConfig(incoming(), existing().host.id)
                        )
                      )
                      || (
                        isHostModerator(existing().host.id, request.auth.uid)
                        && incoming().host.id == existing().host.id
                        && incoming().diff(existing()).affectedKeys().hasOnly([
                          'seats',
                          'seatRequests',
                          'mutedSeatIndices',
                          'isLocked',
                          'allowJoin',
                          'announcement',
                          'chatClearedAt',
                          'viewersCount',
                          'numericParticipants',
                          'participantCount',
                          'likesCount',
                          'lastHeartEvent'
                        ])
                        && (
                          !incoming().diff(existing()).affectedKeys().hasAny(['seats'])
                          || isValidGuestPartySeatUpdate(incoming(), existing())
                        )
                        && (!('chatClearedAt' in incoming()) || incoming().chatClearedAt is number)
                        && (!('announcement' in incoming()) || (incoming().announcement is string && incoming().announcement.size() <= 500))
                        && (!('mutedSeatIndices' in incoming()) || (incoming().mutedSeatIndices is list && incoming().mutedSeatIndices.size() <= 16))
                      )
                      || (
                        !isBlockedBy(existing().host.id, request.auth.uid)
                        && !isKickedFromRoom(roomId, request.auth.uid)
                        && incoming().diff(existing()).affectedKeys().hasOnly(['seats', 'seatRequests', 'viewersCount', 'numericParticipants', 'participantCount', 'likesCount', 'lastHeartEvent'])
                        && (
                          !incoming().diff(existing()).affectedKeys().hasAny(['seats'])
                          || isValidGuestPartySeatUpdate(incoming(), existing())
                        )
                      )
                    );
      allow delete: if isSignedIn() && isValidId(roomId) && (existing().host.id == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId);
        allow list: if isSignedIn() && isValidId(roomId);
        allow create: if isSignedIn()
                      && isValidId(roomId)
                      && isValidId(messageId)
                      && exists(/databases/$(database)/documents/party_rooms/$(roomId))
                      && !isBlockedBy(get(/databases/$(database)/documents/party_rooms/$(roomId)).data.host.id, request.auth.uid)
                      && !isKickedFromRoom(roomId, request.auth.uid)
                      && incoming().userId == request.auth.uid
                      && incoming().text is string
                      && incoming().text.size() > 0
                      && incoming().text.size() <= 500
                      && (!('replyToMessageId' in incoming()) || (incoming().replyToMessageId is string && incoming().replyToMessageId.size() <= 128))
                      && (!('replyToUserId' in incoming()) || (incoming().replyToUserId is string && incoming().replyToUserId.size() <= 128))
                      && (!('replyToUserName' in incoming()) || (incoming().replyToUserName is string && incoming().replyToUserName.size() <= 64))
                      && (!('replyToText' in incoming()) || (incoming().replyToText is string && incoming().replyToText.size() <= 180));
        allow update: if false;
        allow delete: if isSignedIn()
                      && isValidId(roomId)
                      && isValidId(messageId)
                      && (
                        existing().userId == request.auth.uid
                        || get(/databases/$(database)/documents/party_rooms/$(roomId)).data.host.id == request.auth.uid
                        || isHostModerator(get(/databases/$(database)/documents/party_rooms/$(roomId)).data.host.id, request.auth.uid)
                        || isAdmin()
                      );
      }

      match /participants/{participantId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(participantId);
        allow list: if isSignedIn() && isValidId(roomId);
        allow create, update: if isSignedIn()
                              && isValidId(roomId)
                              && isValidId(participantId)
                              && exists(/databases/$(database)/documents/party_rooms/$(roomId))
                              && (
                                (
                                  participantId == request.auth.uid
                                  && !isBlockedBy(get(/databases/$(database)/documents/party_rooms/$(roomId)).data.host.id, request.auth.uid)
                                  && !isKickedFromRoom(roomId, request.auth.uid)
                                )
                                || get(/databases/$(database)/documents/party_rooms/$(roomId)).data.host.id == request.auth.uid
                                || isAdmin()
                              )
                              && incoming().userId is string
                              && incoming().userId.size() <= 128;
        allow delete: if isSignedIn()
                      && isValidId(roomId)
                      && isValidId(participantId)
                      && (
                        participantId == request.auth.uid
                        || get(/databases/$(database)/documents/party_rooms/$(roomId)).data.host.id == request.auth.uid
                        || isHostModerator(get(/databases/$(database)/documents/party_rooms/$(roomId)).data.host.id, request.auth.uid)
                        || isAdmin()
                      );
      }
    }

    // ========================================================
    // 4. LIVE STREAMS COLLECTION (/live_streams/{streamId})
    // ========================================================
    match /live_streams/{streamId} {
      allow get: if isSignedIn() && isValidId(streamId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(streamId)
                    && incoming().host.id == request.auth.uid;
      allow update: if isSignedIn()
                    && isValidId(streamId)
                    && (
                      isAdmin()
                      || (existing().host.id == request.auth.uid && incoming().host.id == existing().host.id)
                      || (
                        !isBlockedBy(existing().host.id, request.auth.uid)
                        && incoming().diff(existing()).affectedKeys().hasOnly(['viewersCount', 'numericViewers', 'viewerCount', 'likesCount', 'commentsCount', 'lastHeartEvent'])
                      )
                    );
      allow delete: if isSignedIn() && isValidId(streamId) && (existing().host.id == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(streamId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(streamId);
        allow create: if isSignedIn()
                      && isValidId(streamId)
                      && isValidId(commentId)
                      && exists(/databases/$(database)/documents/live_streams/$(streamId))
                      && !isBlockedBy(get(/databases/$(database)/documents/live_streams/$(streamId)).data.host.id, request.auth.uid)
                      && incoming().userId == request.auth.uid
                      && incoming().text is string
                      && incoming().text.size() > 0
                      && incoming().text.size() <= 500;
        allow update: if false;
        allow delete: if isSignedIn()
                      && isValidId(streamId)
                      && isValidId(commentId)
                      && (
                        existing().userId == request.auth.uid
                        || get(/databases/$(database)/documents/live_streams/$(streamId)).data.host.id == request.auth.uid
                        || isAdmin()
                      );
      }

      match /viewers/{viewerId} {
        allow get: if isSignedIn() && isValidId(streamId) && isValidId(viewerId);
        allow list: if isSignedIn() && isValidId(streamId);
        allow create, update: if isSignedIn()
                              && isValidId(streamId)
                              && isValidId(viewerId)
                              && exists(/databases/$(database)/documents/live_streams/$(streamId))
                              && (
                                (
                                  viewerId == request.auth.uid
                                  && !isBlockedBy(get(/databases/$(database)/documents/live_streams/$(streamId)).data.host.id, request.auth.uid)
                                )
                                || get(/databases/$(database)/documents/live_streams/$(streamId)).data.host.id == request.auth.uid
                                || isAdmin()
                              )
                              && incoming().userId is string
                              && incoming().userId.size() <= 128;
        allow delete: if isSignedIn()
                      && isValidId(streamId)
                      && isValidId(viewerId)
                      && (
                        viewerId == request.auth.uid
                        || get(/databases/$(database)/documents/live_streams/$(streamId)).data.host.id == request.auth.uid
                        || isAdmin()
                      );
      }
    }

    // ========================================================
    // 5. CHATS & CONVERSATIONS (/chats/{chatId})
    // ========================================================
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(chatId);
      allow update: if isSignedIn() && isValidId(chatId);
      allow delete: if isAdmin() && isValidId(chatId);

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(messageId);
        allow list: if isSignedIn() && isValidId(chatId);
        allow create: if isSignedIn()
                      && isValidId(chatId)
                      && isValidId(messageId)
                      && incoming().senderId == request.auth.uid
                      && (!('recipientId' in incoming()) || (!isBlockedBy(incoming().recipientId, request.auth.uid) && !isBlockedBy(request.auth.uid, incoming().recipientId)))
                      && (!('text' in incoming()) || (incoming().text is string && incoming().text.size() <= 2000));
        allow update: if isSignedIn()
                      && isValidId(chatId)
                      && isValidId(messageId)
                      && (
                        isAdmin()
                        || existing().senderId == request.auth.uid
                        || incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'isPinned', 'isStarred', 'deletedForUsers', 'status'])
                      );
        allow delete: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    // ========================================================
    // 6. GROUPS COLLECTION (/groups/{groupId})
    // ========================================================
    match /groups/{groupId} {
      allow get: if isSignedIn() && isValidId(groupId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(groupId)
                    && incoming().creatorId == request.auth.uid
                    && incoming().name is string && incoming().name.size() <= 100;
      allow update: if isSignedIn()
                    && isValidId(groupId)
                    && (
                      isAdmin()
                      || existing().creatorId == request.auth.uid
                      || incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'membersCount', 'lastMessage', 'lastMessageTime', 'updatedAt'])
                    );
      allow delete: if isSignedIn() && isValidId(groupId) && (existing().creatorId == request.auth.uid || isAdmin());
    }

    // ========================================================
    // 7. WALLETS COLLECTION (/wallets/{uid}) — OWNER & ADMIN ONLY
    // ========================================================
    function isValidWallet(data) {
      return data.keys().hasAll(['userId', 'walletPurchasedCoins'])
        && data.userId is string && data.userId.size() <= 128
        && data.walletPurchasedCoins is number && data.walletPurchasedCoins >= 0
        && (!('totalCoinsPurchased' in data) || (data.totalCoinsPurchased is number && data.totalCoinsPurchased >= 0))
        && (!('totalCoinsSpent' in data) || (data.totalCoinsSpent is number && data.totalCoinsSpent >= 0));
    }

    function isVerifiedEarningsConversion(uid, coinIncrease) {
      return coinIncrease > 0
        && exists(/databases/$(database)/documents/earnings/$(uid))
        && get(/databases/$(database)/documents/earnings/$(uid)).data.availableEarningsCoins is number
        && getAfter(/databases/$(database)/documents/earnings/$(uid)).data.availableEarningsCoins is number
        && getAfter(/databases/$(database)/documents/earnings/$(uid)).data.availableEarningsCoins
           < get(/databases/$(database)/documents/earnings/$(uid)).data.availableEarningsCoins
        && coinIncrease
           <= (get(/databases/$(database)/documents/earnings/$(uid)).data.availableEarningsCoins
               - getAfter(/databases/$(database)/documents/earnings/$(uid)).data.availableEarningsCoins);
    }

    match /wallets/{uid} {
      allow get: if (isOwner(uid) || isAdmin() || isActiveCoinSellerOwner()) && isValidId(uid);
      allow list: if (isOwner(uid) || isAdmin());
      allow create: if isValidId(uid)
                    && isValidWallet(incoming())
                    && (
                      isAdmin()
                      || (
                        isOwner(uid)
                        && incoming().userId == request.auth.uid
                        && (!('totalCoinsPurchased' in incoming()) || incoming().totalCoinsPurchased == 0)
                        && (!('totalCoinsSpent' in incoming()) || incoming().totalCoinsSpent == 0)
                        && (
                          incoming().walletPurchasedCoins == 0
                          || isVerifiedEarningsConversion(uid, incoming().walletPurchasedCoins)
                        )
                      )
                      || (
                        incoming().userId == uid
                        && (!('totalCoinsSpent' in incoming()) || incoming().totalCoinsSpent == 0)
                        && isVerifiedCoinSellerAgencyTransfer(incoming().walletPurchasedCoins)
                        && (!('totalCoinsPurchased' in incoming()) || incoming().totalCoinsPurchased == incoming().walletPurchasedCoins)
                      )
                    );
      allow update: if isValidId(uid)
                    && isValidWallet(incoming())
                    && (
                      isAdmin()
                      || (
                        isOwner(uid)
                        && incoming().userId == existing().userId
                        && (!('totalCoinsPurchased' in incoming()) || !('totalCoinsPurchased' in existing()) || incoming().totalCoinsPurchased == existing().totalCoinsPurchased)
                        && (
                          incoming().walletPurchasedCoins <= existing().walletPurchasedCoins
                          || isVerifiedEarningsConversion(uid, incoming().walletPurchasedCoins - existing().walletPurchasedCoins)
                        )
                      )
                      || (
                        incoming().userId == existing().userId
                        && incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'walletPurchasedCoins', 'totalCoinsPurchased', 'updatedAt'])
                        && isVerifiedCoinSellerAgencyTransfer(incoming().walletPurchasedCoins - existing().walletPurchasedCoins)
                      )
                    );
      allow delete: if false;
    }

    // ========================================================
    // 8. EARNINGS COLLECTION (/earnings/{uid})
    // ========================================================
    function isValidEarnings(data) {
      return data.userId is string && data.userId.size() <= 128
        && (!('availableEarningsCoins' in data) || (data.availableEarningsCoins is number && data.availableEarningsCoins >= 0))
        && (!('pendingWithdrawalCoins' in data) || (data.pendingWithdrawalCoins is number && data.pendingWithdrawalCoins >= 0))
        && (!('totalWithdrawnCoins' in data) || (data.totalWithdrawnCoins is number && data.totalWithdrawnCoins >= 0))
        && (!('grossGiftCoinsReceived' in data) || (data.grossGiftCoinsReceived is number && data.grossGiftCoinsReceived >= 0))
        && (!('totalCommissionDeducted' in data) || (data.totalCommissionDeducted is number && data.totalCommissionDeducted >= 0))
        && (!('totalConvertedToWallet' in data) || (data.totalConvertedToWallet is number && data.totalConvertedToWallet >= 0))
        && (!('totalGiftsCount' in data) || (data.totalGiftsCount is number && data.totalGiftsCount >= 0));
    }

    match /earnings/{uid} {
      // Signed-in get allowed for atomic gift credit runTransaction; list restricted to owner/admin
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && isValidId(uid) && isValidEarnings(incoming()) && (
                      isAdmin()
                      || (isOwner(uid) && incoming().userId == request.auth.uid)
                      || (
                        // Initial earnings record created when another user sends the first gift
                        incoming().userId == uid
                        && (!('pendingWithdrawalCoins' in incoming()) || incoming().pendingWithdrawalCoins == 0)
                        && (!('totalWithdrawnCoins' in incoming()) || incoming().totalWithdrawnCoins == 0)
                        && (!('totalConvertedToWallet' in incoming()) || incoming().totalConvertedToWallet == 0)
                      )
                    );

      allow update: if isSignedIn() && isValidId(uid) && isValidEarnings(incoming()) && (
                      isAdmin()
                      || (
                        // Owner converting earnings to wallet or reserving pending withdrawal coins
                        isOwner(uid)
                        && incoming().userId == existing().userId
                        && (!('totalWithdrawnCoins' in existing()) || incoming().totalWithdrawnCoins == existing().totalWithdrawnCoins)
                        && incoming().availableEarningsCoins <= existing().availableEarningsCoins
                      )
                      || (
                        // Gifter crediting recipient upward only; cannot touch pending/withdrawn/converted totals
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'userId',
                          'availableEarningsCoins',
                          'grossGiftCoinsReceived',
                          'totalCommissionDeducted',
                          'totalGiftsCount',
                          'updatedAt'
                        ])
                        && incoming().availableEarningsCoins >= existing().availableEarningsCoins
                      )
                    );

      allow delete: if false;
    }

    // ========================================================
    // 9. FINANCIAL TRANSACTIONS COLLECTIONS (IMMUTABLE AUDIT LOGS)
    // ========================================================
    match /wallet_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(txId)
                    && incoming().amount is number
                    && (
                      isAdmin()
                      || (
                        incoming().userId == request.auth.uid
                        && incoming().category in ['gift_sent', 'earnings_conversion']
                        && (incoming().category != 'gift_sent' || incoming().amount <= 0)
                      )
                      || (
                        incoming().category == 'coin_purchase'
                        && incoming().amount > 0
                        && isVerifiedCoinSellerAgencyTransfer(incoming().amount)
                      )
                    );
      allow update, delete: if false;
    }

    match /earnings_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(txId)
                    && incoming().amount is number
                    && (
                      incoming().userId == request.auth.uid
                      || isAdmin()
                      || (incoming().category == 'gift_received' && incoming().metadata.senderId == request.auth.uid)
                    );
      allow update, delete: if false;
    }

    match /commission_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (resource.data.senderId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(txId)
                    && (incoming().senderId == request.auth.uid || isAdmin())
                    && incoming().grossCost is number && incoming().grossCost > 0
                    && incoming().commissionCoins is number && incoming().commissionCoins >= 0;
      allow update, delete: if false;
    }

    // ========================================================
    // 10. WITHDRAWAL REQUESTS (/withdrawal_requests/{reqId}) — STRICT PII + ADMIN APPROVAL
    // ========================================================
    function isValidWithdrawalRequest(data) {
      return data.keys().hasAll(['userId', 'coinsRequested', 'paymentMethod', 'status'])
        && data.userId is string && data.userId.size() <= 128
        && data.coinsRequested is number && data.coinsRequested > 0
        && data.paymentMethod in ['bank_transfer', 'jazzcash', 'easypaisa', 'cash_pickup']
        && data.status in ['pending', 'under_review', 'approved', 'processing', 'paid', 'rejected', 'cancelled'];
    }

    match /withdrawal_requests/{reqId} {
      allow get: if isSignedIn() && isValidId(reqId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(reqId)
                    && incoming().userId == request.auth.uid
                    && incoming().status == 'pending'
                    && isValidWithdrawalRequest(incoming());
      allow update: if isSignedIn()
                    && isValidId(reqId)
                    && isValidWithdrawalRequest(incoming())
                    && isAdmin();
      allow delete: if false;
    }

    // ========================================================
    // 11. WALLET SETTINGS & RECHARGE PACKAGES — ADMIN WRITE ONLY
    // ========================================================
    match /wallet_settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(settingId);
      allow delete: if false;
    }

    match /coin_packages/{pkgId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(pkgId);
      allow delete: if false;
    }

    function isValidCoinSellerAgency(data) {
      return data.keys().hasAll([
          'id', 'name', 'ownerName', 'agencyCode', 'city', 'country',
          'whatsapp', 'phone', 'paymentMethods', 'workingHours',
          'isVerified', 'isOnline', 'enabled'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'ownerName', 'agencyCode', 'city', 'country',
          'whatsapp', 'phone', 'paymentMethods', 'workingHours',
          'minCoinsOrder', 'rateNote', 'badge',
          'isVerified', 'isOnline', 'enabled', 'updatedAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.ownerName is string && data.ownerName.size() > 0 && data.ownerName.size() <= 60
        && data.agencyCode is string && data.agencyCode.size() > 0 && data.agencyCode.size() <= 24
        && data.city is string && data.city.size() > 0 && data.city.size() <= 50
        && data.country is string && data.country.size() > 0 && data.country.size() <= 50
        && data.whatsapp is string && data.whatsapp.size() > 0 && data.whatsapp.size() <= 24
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 24
        && data.paymentMethods is list && data.paymentMethods.size() > 0 && data.paymentMethods.size() <= 8
        && data.workingHours is string && data.workingHours.size() > 0 && data.workingHours.size() <= 60
        && data.isVerified is bool
        && data.isOnline is bool
        && data.enabled is bool
        && (!('minCoinsOrder' in data) || (data.minCoinsOrder is number && data.minCoinsOrder >= 0))
        && (!('rateNote' in data) || (data.rateNote is string && data.rateNote.size() <= 120))
        && (!('badge' in data) || (data.badge is string && data.badge.size() <= 24))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /coin_seller_agencies/{agencyId} {
      allow get: if isSignedIn() && isValidId(agencyId) && (resource.data.enabled == true || isAdmin());
      allow list: if isSignedIn() && (resource.data.enabled == true || isAdmin());
      allow create, update: if isAdmin() && isValidId(agencyId) && isValidCoinSellerAgency(incoming());
      allow delete: if isAdmin() && isValidId(agencyId);
    }

    // ========================================================
    // 12. 100-LEVEL, 12-VIP, 6-SUPER-VIP & ACHIEVEMENT PROGRESSION SYSTEM
    // ========================================================
    function isValidUserLevel(data) {
      return data.keys().hasAll(['userId', 'currentLevel', 'totalQualifyingCoinsSpent'])
        && data.userId is string && data.userId.size() <= 128
        && data.currentLevel is number && data.currentLevel >= 0 && data.currentLevel <= 100
        && data.totalQualifyingCoinsSpent is number && data.totalQualifyingCoinsSpent >= 0 && data.totalQualifyingCoinsSpent <= 2000000000
        && (!('vipLevel' in data) || (data.vipLevel is number && data.vipLevel >= 0 && data.vipLevel <= 12))
        && (!('superVipLevel' in data) || (data.superVipLevel is number && data.superVipLevel >= 0 && data.superVipLevel <= 6))
        && (!('equippedVipFrame' in data) || (data.equippedVipFrame is number && data.equippedVipFrame >= 0 && data.equippedVipFrame <= 12))
        && (!('equippedSuperVipFrame' in data) || (data.equippedSuperVipFrame is number && data.equippedSuperVipFrame >= 0 && data.equippedSuperVipFrame <= 6))
        && (!('activeFrameType' in data) || data.activeFrameType in ['none', 'vip', 'super_vip'])
        && (!('unlockedVipTiers' in data) || (data.unlockedVipTiers is list && data.unlockedVipTiers.size() <= 12))
        && (!('unlockedSuperVipTiers' in data) || (data.unlockedSuperVipTiers is list && data.unlockedSuperVipTiers.size() <= 6))
        && (!('equippedAchievementBadges' in data) || (data.equippedAchievementBadges is list && data.equippedAchievementBadges.size() <= 3));
    }

    match /user_levels/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(uid)
                    && isValidUserLevel(incoming())
                    && (isAdmin() || (isOwner(uid) && incoming().userId == request.auth.uid));
      allow update: if isValidId(uid)
                    && isValidUserLevel(incoming())
                    && (isAdmin() || (isOwner(uid) && incoming().userId == existing().userId));
      allow delete: if false;
    }

    match /level_configurations/{docId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(docId);
      allow delete: if false;
    }

    match /vip_frames/{docId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(docId);
      allow delete: if false;
    }

    match /super_vip_frames/{docId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(docId);
      allow delete: if false;
    }

    match /achievement_definitions/{docId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(docId);
      allow delete: if false;
    }

    match /progression_audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
                    && isValidId(logId)
                    && incoming().adminEmail is string
                    && incoming().action is string
                    && incoming().reason is string;
      allow update, delete: if false;
    }

    // ========================================================
    // 13. FOLLOWS GRAPH (/follows/{followId})
    // ========================================================
    match /follows/{followId} {
      allow get: if isSignedIn() && isValidId(followId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(followId)
                    && incoming().followerId == request.auth.uid
                    && incoming().followingId is string
                    && incoming().followingId.size() > 0
                    && incoming().followingId.size() <= 128
                    && incoming().followingId != request.auth.uid
                    && !isBlockedBy(incoming().followingId, request.auth.uid)
                    && !isBlockedBy(request.auth.uid, incoming().followingId);
      allow update: if false;
      allow delete: if isSignedIn()
                    && isValidId(followId)
                    && (existing().followerId == request.auth.uid || isAdmin());
    }

    // ========================================================
    // 14. BROADCASTER RANKING CONFIG (/ranking_configs/{configId})
    // ========================================================
    match /ranking_configs/{configId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin()
                            && isValidId(configId)
                            && incoming().viewerWeight is number
                            && incoming().giftWeight is number
                            && incoming().engagementWeight is number
                            && incoming().durationWeight is number;
      allow delete: if false;
    }

    // ========================================================
    // 15. LENZO PARTY STORE (store_categories, store_products, user_inventory, coin_transactions)
    // ========================================================
    function isValidStoreCategoryId(catId) {
      return catId in ['vip_frames', 'special_entry', 'custom_gift', 'premium_assets'];
    }

    function isValidStoreCategory(data) {
      return data.keys().hasAll(['id', 'title', 'enabled'])
        && isValidStoreCategoryId(data.id)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 64
        && data.enabled is bool
        && (!('order' in data) || (data.order is number && data.order >= 0 && data.order <= 100));
    }

    function isValidStoreProduct(data) {
      return data.keys().hasAll(['name', 'categoryId', 'priceCoins', 'enabled'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 64
        && isValidStoreCategoryId(data.categoryId)
        && data.priceCoins is number && data.priceCoins >= 1 && data.priceCoins <= 100000000
        && data.enabled is bool
        && (!('description' in data) || (data.description is string && data.description.size() <= 320))
        && (!('isFeatured' in data) || data.isFeatured is bool)
        && (!('sortOrder' in data) || (data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000));
    }

    function isValidUserInventoryItem(data) {
      return data.keys().hasAll(['userId', 'productId', 'categoryId', 'pricePaidCoins', 'equipped'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128
        && isValidStoreCategoryId(data.categoryId)
        && data.pricePaidCoins is number && data.pricePaidCoins >= 0 && data.pricePaidCoins <= 100000000
        && data.equipped is bool;
    }

    function isValidCoinTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'balanceBefore', 'balanceAfter', 'idempotencyKey', 'status'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.type in ['store_purchase', 'coin_recharge', 'admin_adjustment']
        && data.amount is number
        && data.balanceBefore is number && data.balanceBefore >= 0
        && data.balanceAfter is number && data.balanceAfter >= 0
        && data.idempotencyKey is string && data.idempotencyKey.size() > 0 && data.idempotencyKey.size() <= 160
        && data.status in ['completed', 'failed'];
    }

    match /store_categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin()
                            && isValidId(categoryId)
                            && isValidStoreCategoryId(categoryId)
                            && isValidStoreCategory(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /store_products/{productId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin()
                            && isValidId(productId)
                            && isValidStoreProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /user_inventory/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(itemId)
                    && isValidUserInventoryItem(incoming())
                    && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn()
                    && isValidId(itemId)
                    && isValidUserInventoryItem(incoming())
                    && (
                      isAdmin()
                      || (
                        existing().userId == request.auth.uid
                        && incoming().userId == existing().userId
                        && incoming().productId == existing().productId
                        && incoming().categoryId == existing().categoryId
                        && incoming().pricePaidCoins == existing().pricePaidCoins
                      )
                    );
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /coin_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(txId)
                    && isValidCoinTransaction(incoming())
                    && (incoming().userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // ========================================================
    // 16. USER BLOCKING (/blocked_users/{blockId})
    // ========================================================
    function isValidBlockedUser(data) {
      return data.keys().hasAll(['blockerId', 'blockedUserId', 'blockedUserName'])
        && data.keys().hasOnly(['blockerId', 'blockedUserId', 'blockedUserName', 'blockedUserUsername', 'blockedUserDisplayId', 'blockedUserAvatar', 'reason', 'createdAt'])
        && data.blockerId is string && data.blockerId.size() > 0 && data.blockerId.size() <= 128
        && data.blockedUserId is string && data.blockedUserId.size() > 0 && data.blockedUserId.size() <= 128
        && data.blockerId != data.blockedUserId
        && data.blockedUserName is string && data.blockedUserName.size() > 0 && data.blockedUserName.size() <= 64
        && (!('blockedUserUsername' in data) || (data.blockedUserUsername is string && data.blockedUserUsername.size() <= 64))
        && (!('blockedUserDisplayId' in data) || (data.blockedUserDisplayId is string && data.blockedUserDisplayId.size() <= 32))
        && (!('blockedUserAvatar' in data) || (data.blockedUserAvatar is string && data.blockedUserAvatar.size() <= 1500))
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 200));
    }

    match /blocked_users/{blockId} {
      allow get: if isSignedIn()
                 && isValidId(blockId)
                 && (existing().blockerId == request.auth.uid || existing().blockedUserId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
                  && (resource.data.blockerId == request.auth.uid || resource.data.blockedUserId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(blockId)
                    && blockId == (incoming().blockerId + '_' + incoming().blockedUserId)
                    && isValidBlockedUser(incoming())
                    && (
                      incoming().blockerId == request.auth.uid
                      || (
                        isHostModerator(incoming().blockerId, request.auth.uid)
                        && incoming().blockedUserId != incoming().blockerId
                        && !isHostModerator(incoming().blockerId, incoming().blockedUserId)
                      )
                    );
      allow update: if false;
      allow delete: if isSignedIn()
                    && isValidId(blockId)
                    && (existing().blockerId == request.auth.uid || isAdmin());
    }

    // ========================================================
    // 16B. PARTY ROOM KICKS (/room_kicks/{kickId})
    // ========================================================
    function isValidRoomKick(data) {
      return data.keys().hasAll(['roomId', 'hostId', 'targetUserId', 'targetUserName', 'durationType', 'kickedAt'])
        && data.keys().hasOnly([
          'roomId', 'roomTitle', 'hostId', 'targetUserId',
          'targetUserName', 'targetUserAvatar', 'durationType', 'kickedAt', 'expiresAt'
        ])
        && data.roomId is string && data.roomId.size() > 0 && data.roomId.size() <= 128
        && (!('roomTitle' in data) || (data.roomTitle is string && data.roomTitle.size() <= 100))
        && data.hostId is string && data.hostId.size() > 0 && data.hostId.size() <= 128
        && data.targetUserId is string && data.targetUserId.size() > 0 && data.targetUserId.size() <= 128
        && data.hostId != data.targetUserId
        && data.targetUserName is string && data.targetUserName.size() > 0 && data.targetUserName.size() <= 64
        && (!('targetUserAvatar' in data) || (data.targetUserAvatar is string && data.targetUserAvatar.size() <= 1500))
        && data.durationType in ['session', '24h', '15d', '30d']
        && data.kickedAt is number && data.kickedAt > 0
        && (!('expiresAt' in data) || (data.expiresAt is number && data.expiresAt > data.kickedAt));
    }

    match /room_kicks/{kickId} {
      allow get: if isSignedIn()
                 && isValidId(kickId)
                 && (
                   existing().hostId == request.auth.uid
                   || existing().targetUserId == request.auth.uid
                   || isHostModerator(existing().hostId, request.auth.uid)
                   || isAdmin()
                 );
      allow list: if isSignedIn()
                  && (
                    resource.data.hostId == request.auth.uid
                    || resource.data.targetUserId == request.auth.uid
                    || isHostModerator(resource.data.hostId, request.auth.uid)
                    || isAdmin()
                  );
      allow create, update: if isSignedIn()
                            && isValidId(kickId)
                            && kickId == (incoming().roomId + '_' + incoming().targetUserId)
                            && isValidRoomKick(incoming())
                            && (
                              isAdmin()
                              || (
                                incoming().hostId == request.auth.uid
                                && exists(/databases/$(database)/documents/party_rooms/$(incoming().roomId))
                                && get(/databases/$(database)/documents/party_rooms/$(incoming().roomId)).data.host.id == request.auth.uid
                              )
                              || (
                                isHostModerator(incoming().hostId, request.auth.uid)
                                && incoming().targetUserId != incoming().hostId
                                && !isHostModerator(incoming().hostId, incoming().targetUserId)
                                && exists(/databases/$(database)/documents/party_rooms/$(incoming().roomId))
                                && get(/databases/$(database)/documents/party_rooms/$(incoming().roomId)).data.host.id == incoming().hostId
                              )
                            );
      allow delete: if isSignedIn()
                    && isValidId(kickId)
                    && (
                      existing().hostId == request.auth.uid
                      || isHostModerator(existing().hostId, request.auth.uid)
                      || isAdmin()
                    );
    }

    // ========================================================
    // 16C. LIFETIME HOST MODERATORS (/host_moderators/{modId})
    // ========================================================
    function isValidHostModerator(data) {
      return data.keys().hasAll(['hostId', 'moderatorUserId', 'moderatorName', 'assignedAt'])
        && data.keys().hasOnly([
          'hostId', 'moderatorUserId', 'moderatorName', 'moderatorUsername',
          'moderatorDisplayId', 'moderatorAvatar', 'assignedByName', 'assignedAt'
        ])
        && data.hostId is string && data.hostId.size() > 0 && data.hostId.size() <= 128
        && data.moderatorUserId is string && data.moderatorUserId.size() > 0 && data.moderatorUserId.size() <= 128
        && data.hostId != data.moderatorUserId
        && data.moderatorName is string && data.moderatorName.size() > 0 && data.moderatorName.size() <= 64
        && (!('moderatorUsername' in data) || (data.moderatorUsername is string && data.moderatorUsername.size() <= 64))
        && (!('moderatorDisplayId' in data) || (data.moderatorDisplayId is string && data.moderatorDisplayId.size() <= 32))
        && (!('moderatorAvatar' in data) || (data.moderatorAvatar is string && data.moderatorAvatar.size() <= 1500))
        && (!('assignedByName' in data) || (data.assignedByName is string && data.assignedByName.size() <= 64))
        && data.assignedAt is number && data.assignedAt > 0;
    }

    match /host_moderators/{modId} {
      // Public display info only (no PII) so viewers in any room can render Moderator badges on seats & comments
      allow get: if isSignedIn() && isValidId(modId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn()
                            && isValidId(modId)
                            && modId == (request.auth.uid + '_' + incoming().moderatorUserId)
                            && incoming().hostId == request.auth.uid
                            && isValidHostModerator(incoming());
      allow delete: if isSignedIn()
                    && isValidId(modId)
                    && (existing().hostId == request.auth.uid || isAdmin());
    }

    // ========================================================
    // 17. REELS COLLECTION (/reels/{reelId})
    // ========================================================
    function isValidReel(data) {
      return data.keys().hasAll(['reelID', 'creatorUID', 'videoUrl', 'visibility'])
        && data.reelID is string && data.reelID.size() > 0 && data.reelID.size() <= 128
        && data.creatorUID is string && data.creatorUID.size() > 0 && data.creatorUID.size() <= 128
        && data.videoUrl is string && data.videoUrl.size() > 0 && data.videoUrl.size() <= 2048
        && data.visibility in ['public', 'friends', 'private']
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 500))
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('musicTitle' in data) || (data.musicTitle is string && data.musicTitle.size() <= 150))
        && (!('videoStoragePath' in data) || (data.videoStoragePath is string && data.videoStoragePath.size() <= 512))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 160000))
        && (!('thumbnailStoragePath' in data) || (data.thumbnailStoragePath is string && data.thumbnailStoragePath.size() <= 512))
        && (!('videoMimeType' in data) || (data.videoMimeType is string && data.videoMimeType.size() <= 64))
        && (!('mediaChunkCount' in data) || (data.mediaChunkCount is number && data.mediaChunkCount >= 1 && data.mediaChunkCount <= 40))
        && (!('hashtags' in data) || (data.hashtags is list && data.hashtags.size() <= 12))
        && (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0))
        && (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0))
        && (!('sharesCount' in data) || (data.sharesCount is number && data.sharesCount >= 0))
        && (!('repostsCount' in data) || (data.repostsCount is number && data.repostsCount >= 0))
        && (!('fileSizeBytes' in data) || (data.fileSizeBytes is number && data.fileSizeBytes > 0 && data.fileSizeBytes <= 104857600))
        && (!('storageBackend' in data) || data.storageBackend in ['firebase_storage', 'server_media', 'firestore_chunks'])
        && (!('isPrivate' in data) || data.isPrivate is bool)
        && (!('processingStatus' in data) || data.processingStatus in ['uploading', 'processing', 'ready', 'failed']);
    }

    match /reels/{reelId} {
      allow get: if isSignedIn() && isValidId(reelId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(reelId)
                    && incoming().reelID == reelId
                    && incoming().creatorUID == request.auth.uid
                    && isValidReel(incoming());
      allow update: if isSignedIn()
                    && isValidId(reelId)
                    && isValidReel(incoming())
                    && (
                      isAdmin()
                      || (
                        existing().creatorUID == request.auth.uid
                        && incoming().creatorUID == existing().creatorUID
                        && incoming().reelID == existing().reelID
                      )
                      || incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'viewsCount', 'sharesCount', 'repostsCount'])
                    );
      allow delete: if isSignedIn()
                    && isValidId(reelId)
                    && (existing().creatorUID == request.auth.uid || isAdmin());

      match /media_chunks/{chunkId} {
        allow get: if isSignedIn() && isValidId(reelId) && isValidId(chunkId);
        allow list: if isSignedIn() && isValidId(reelId);
        allow create: if isSignedIn()
                      && isValidId(reelId)
                      && isValidId(chunkId)
                      && incoming().creatorUID == request.auth.uid
                      && incoming().reelId == reelId
                      && incoming().chunkIndex is number
                      && incoming().chunkIndex >= 0
                      && incoming().chunkIndex < 40
                      && incoming().data is string
                      && incoming().data.size() > 0
                      && incoming().data.size() <= 750000;
        allow update: if false;
        allow delete: if isSignedIn()
                      && isValidId(reelId)
                      && isValidId(chunkId)
                      && (existing().creatorUID == request.auth.uid || isAdmin());
      }
    }

    // ========================================================
    // 18. REEL ENGAGEMENT (/reel_likes, /reel_comments, /reel_views)
    // ========================================================
    match /reel_likes/{likeId} {
      allow get: if isSignedIn() && isValidId(likeId);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(likeId)
                    && incoming().userId == request.auth.uid
                    && incoming().reelId is string
                    && incoming().reelId.size() > 0
                    && incoming().reelId.size() <= 128
                    && likeId == (incoming().reelId + '_' + request.auth.uid)
                    && (
                      !exists(/databases/$(database)/documents/reels/$(incoming().reelId))
                      || !isBlockedBy(get(/databases/$(database)/documents/reels/$(incoming().reelId)).data.creatorUID, request.auth.uid)
                    );
      allow update: if false;
      allow delete: if isSignedIn()
                    && isValidId(likeId)
                    && (existing().userId == request.auth.uid || isAdmin());
    }

    match /reel_comments/{commentId} {
      allow get: if isSignedIn() && isValidId(commentId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(commentId)
                    && incoming().userId == request.auth.uid
                    && incoming().reelId is string
                    && incoming().reelId.size() > 0
                    && incoming().reelId.size() <= 128
                    && (
                      !exists(/databases/$(database)/documents/reels/$(incoming().reelId))
                      || !isBlockedBy(get(/databases/$(database)/documents/reels/$(incoming().reelId)).data.creatorUID, request.auth.uid)
                    )
                    && incoming().text is string
                    && incoming().text.size() > 0
                    && incoming().text.size() <= 400
                    && (!('userName' in incoming()) || (incoming().userName is string && incoming().userName.size() <= 80))
                    && (!('userAvatar' in incoming()) || (incoming().userAvatar is string && incoming().userAvatar.size() <= 1500));
      allow update: if false;
      allow delete: if isSignedIn()
                    && isValidId(commentId)
                    && (existing().userId == request.auth.uid || isAdmin());
    }

    match /reel_views/{viewId} {
      allow get: if isSignedIn() && isValidId(viewId);
      allow list: if isAdmin();
      allow create: if isSignedIn()
                    && isValidId(viewId)
                    && incoming().userId == request.auth.uid
                    && incoming().reelId is string
                    && incoming().reelId.size() > 0
                    && incoming().reelId.size() <= 128
                    && viewId == (incoming().reelId + '_' + request.auth.uid);
      allow update, delete: if false;
    }

    // ========================================================
    // 19. PRIVATE USER SETTINGS (/user_settings/{uid})
    // ========================================================
    function isValidUserSettings(data, uid) {
      return data.keys().hasAll(['userId', 'notificationsEnabled', 'darkMode', 'language'])
        && data.userId == uid
        && data.notificationsEnabled is bool
        && data.darkMode is bool
        && data.language is string && data.language.size() > 0 && data.language.size() <= 40
        && (!('showOnlineStatus' in data) || data.showOnlineStatus is bool)
        && (!('allowDirectMessages' in data) || data.allowDirectMessages in ['everyone', 'followers', 'nobody'])
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /user_settings/{uid} {
      allow get: if (isOwner(uid) || isAdmin()) && isValidId(uid);
      allow list: if isAdmin();
      allow create, update: if (isOwner(uid) || isAdmin())
                            && isValidId(uid)
                            && isValidUserSettings(incoming(), uid);
      allow delete: if false;
    }

    // ========================================================
    // 20. CONTENT & USER REPORTS (/reports/{reportId})
    // ========================================================
    match /reports/{reportId} {
      allow get: if isSignedIn()
                 && isValidId(reportId)
                 && (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
                  && (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(reportId)
                    && incoming().reporterUid == request.auth.uid
                    && incoming().targetType in ['reel', 'user', 'room', 'stream']
                    && incoming().targetId is string && incoming().targetId.size() > 0 && incoming().targetId.size() <= 128
                    && (!('targetOwnerUid' in incoming()) || (incoming().targetOwnerUid is string && incoming().targetOwnerUid.size() <= 128))
                    && incoming().reason is string && incoming().reason.size() > 0 && incoming().reason.size() <= 120
                    && (!('details' in incoming()) || (incoming().details is string && incoming().details.size() <= 500))
                    && incoming().status == 'open';
      allow update: if isAdmin() && isValidId(reportId);
      allow delete: if false;
    }

    // ========================================================
    // 21. ACCOUNT DELETION REQUESTS (/deletion_requests/{uid})
    // ========================================================
    match /deletion_requests/{uid} {
      allow get: if (isOwner(uid) || isAdmin()) && isValidId(uid);
      allow list: if isAdmin();
      allow create, update: if isOwner(uid)
                            && isValidId(uid)
                            && incoming().userId == request.auth.uid
                            && incoming().status == 'pending'
                            && (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 120))
                            && incoming().reason is string && incoming().reason.size() <= 300;
      allow delete: if isAdmin() && isValidId(uid);
    }

    // ========================================================
    // 22. DUAL AGENCY SYSTEM (Coin Seller Agency & Host Agency)
    // ========================================================
    function isValidAgencyApplication(data) {
      return data.keys().hasAll([
          'applicantUid', 'applicantDisplayId', 'agencyType', 'fullName',
          'agencyName', 'username', 'phoneNumber', 'whatsappNumber',
          'idCardNumber', 'description', 'status'
        ])
        && data.applicantUid is string && data.applicantUid.size() > 0 && data.applicantUid.size() <= 128
        && data.applicantDisplayId is string && data.applicantDisplayId.size() > 0 && data.applicantDisplayId.size() <= 32
        && data.agencyType in ['coin_seller', 'host_agency']
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80
        && data.agencyName is string && data.agencyName.size() >= 2 && data.agencyName.size() <= 80
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 60
        && data.phoneNumber is string && data.phoneNumber.size() >= 7 && data.phoneNumber.size() <= 32
        && data.whatsappNumber is string && data.whatsappNumber.size() >= 7 && data.whatsappNumber.size() <= 32
        && data.idCardNumber is string && data.idCardNumber.size() >= 5 && data.idCardNumber.size() <= 40
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 600
        && data.status in ['pending', 'approved', 'rejected']
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300))
        && (!('createdAgencyId' in data) || (data.createdAgencyId is string && data.createdAgencyId.size() <= 140));
    }

    // Strict PII isolation: contains CNIC/ID Card & personal phone -> applicant or Admin only
    match /agency_applications/{applicationId} {
      allow get: if isSignedIn()
                 && isValidId(applicationId)
                 && (resource.data.applicantUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
                  && (resource.data.applicantUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(applicationId)
                    && incoming().applicantUid == request.auth.uid
                    && incoming().status == 'pending'
                    && isValidAgencyApplication(incoming());
      allow update: if isAdmin()
                    && isValidId(applicationId)
                    && isValidAgencyApplication(incoming());
      allow delete: if isAdmin() && isValidId(applicationId);
    }

    function isValidDualAgency(data, agencyId) {
      return data.keys().hasAll([
          'id', 'agencyType', 'name', 'agencyCode', 'ownerUid',
          'ownerName', 'whatsappNumber', 'status', 'isVerified'
        ])
        && !data.keys().hasAny(['idCardNumber', 'pinHash', 'pinSalt'])
        && data.id == agencyId
        && data.agencyType in ['coin_seller', 'host_agency']
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.agencyCode is string && data.agencyCode.size() >= 2 && data.agencyCode.size() <= 24
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80
        && (!('ownerUsername' in data) || (data.ownerUsername is string && data.ownerUsername.size() <= 60))
        && (!('ownerDisplayId' in data) || (data.ownerDisplayId is string && data.ownerDisplayId.size() <= 32))
        && (!('ownerAvatar' in data) || (data.ownerAvatar is string && data.ownerAvatar.size() <= 1500))
        && data.whatsappNumber is string && data.whatsappNumber.size() >= 7 && data.whatsappNumber.size() <= 32
        && (!('description' in data) || (data.description is string && data.description.size() <= 600))
        && data.status in ['active', 'suspended']
        && data.isVerified is bool
        && (!('isOnline' in data) || data.isOnline is bool)
        && (!('coinBalance' in data) || (data.coinBalance is number && data.coinBalance >= 0))
        && (!('totalTransferredCoins' in data) || (data.totalTransferredCoins is number && data.totalTransferredCoins >= 0))
        && (!('totalHosts' in data) || (data.totalHosts is number && data.totalHosts >= 0))
        && (!('hasPin' in data) || data.hasPin is bool);
    }

    match /agencies/{agencyId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin()
                    && isValidId(agencyId)
                    && isValidDualAgency(incoming(), agencyId);
      allow update: if isSignedIn()
                    && isValidId(agencyId)
                    && isValidDualAgency(incoming(), agencyId)
                    && (
                      isAdmin()
                      || (
                        // Owner updating agency WhatsApp, description, name, online status, or hasPin flag
                        existing().ownerUid == request.auth.uid
                        && incoming().ownerUid == existing().ownerUid
                        && incoming().agencyType == existing().agencyType
                        && incoming().status == existing().status
                        && incoming().isVerified == existing().isVerified
                        && incoming().diff(existing()).affectedKeys().hasOnly([
                          'name', 'whatsappNumber', 'description', 'isOnline', 'hasPin', 'updatedAt'
                        ])
                      )
                      || (
                        // Coin Seller Owner deducting their own coinBalance during a transfer
                        existing().ownerUid == request.auth.uid
                        && existing().agencyType == 'coin_seller'
                        && existing().status == 'active'
                        && agencyId == ('cs_' + request.auth.uid)
                        && incoming().diff(existing()).affectedKeys().hasOnly([
                          'coinBalance', 'totalTransferredCoins', 'updatedAt'
                        ])
                        && existing().coinBalance is number
                        && incoming().coinBalance is number
                        && incoming().coinBalance >= 0
                        && incoming().coinBalance < existing().coinBalance
                        && incoming().totalTransferredCoins == (
                          (('totalTransferredCoins' in existing() && existing().totalTransferredCoins is number) ? existing().totalTransferredCoins : 0)
                          + (existing().coinBalance - incoming().coinBalance)
                        )
                      )
                      || (
                        // Host Agency Owner updating active host counter
                        existing().ownerUid == request.auth.uid
                        && existing().agencyType == 'host_agency'
                        && existing().status == 'active'
                        && incoming().diff(existing()).affectedKeys().hasOnly(['totalHosts', 'updatedAt'])
                        && incoming().totalHosts is number
                        && incoming().totalHosts >= 0
                      )
                    );
      allow delete: if isAdmin() && isValidId(agencyId);

      // Owner-only Secret Transfer PIN Vault (salted SHA-256 hash, never plaintext)
      match /secrets/{secretId} {
        allow get: if isSignedIn()
                   && isValidId(agencyId)
                   && secretId == 'pin'
                   && exists(/databases/$(database)/documents/agencies/$(agencyId))
                   && (
                     get(/databases/$(database)/documents/agencies/$(agencyId)).data.ownerUid == request.auth.uid
                     || isAdmin()
                   );
        allow list: if false;
        allow create, update: if isSignedIn()
                              && isValidId(agencyId)
                              && secretId == 'pin'
                              && exists(/databases/$(database)/documents/agencies/$(agencyId))
                              && get(/databases/$(database)/documents/agencies/$(agencyId)).data.ownerUid == request.auth.uid
                              && incoming().keys().hasAll(['pinHash', 'pinSalt', 'pinLength'])
                              && incoming().keys().hasOnly(['pinHash', 'pinSalt', 'pinLength', 'updatedAt'])
                              && incoming().pinHash is string && incoming().pinHash.size() == 64
                              && incoming().pinSalt is string && incoming().pinSalt.size() >= 16 && incoming().pinSalt.size() <= 64
                              && incoming().pinLength is number && (incoming().pinLength == 4 || incoming().pinLength == 5);
        allow delete: if isAdmin() && isValidId(agencyId);
      }
    }

    match /agency_coin_transfers/{transferId} {
      allow get: if isSignedIn()
                 && isValidId(transferId)
                 && (
                   resource.data.senderUid == request.auth.uid
                   || resource.data.recipientUid == request.auth.uid
                   || isAdmin()
                 );
      allow list: if isSignedIn()
                  && (
                    resource.data.senderUid == request.auth.uid
                    || resource.data.recipientUid == request.auth.uid
                    || isAdmin()
                  );
      allow create: if isSignedIn()
                    && isValidId(transferId)
                    && incoming().senderUid == request.auth.uid
                    && incoming().agencyId == ('cs_' + request.auth.uid)
                    && incoming().recipientUid is string && incoming().recipientUid.size() > 0 && incoming().recipientUid.size() <= 128
                    && incoming().amount is number && incoming().amount > 0
                    && incoming().balanceAfter is number && incoming().balanceAfter >= 0
                    && isVerifiedCoinSellerAgencyTransfer(incoming().amount);
      allow update, delete: if false;
    }

    function isValidHostAgencyRequest(data) {
      return data.keys().hasAll([
          'agencyId', 'agencyName', 'agencyOwnerUid', 'hostUid', 'hostName', 'status'
        ])
        && data.agencyId is string && data.agencyId.size() > 0 && data.agencyId.size() <= 140
        && data.agencyName is string && data.agencyName.size() > 0 && data.agencyName.size() <= 80
        && data.agencyOwnerUid is string && data.agencyOwnerUid.size() > 0 && data.agencyOwnerUid.size() <= 128
        && data.hostUid is string && data.hostUid.size() > 0 && data.hostUid.size() <= 128
        && data.hostName is string && data.hostName.size() > 0 && data.hostName.size() <= 80
        && data.status in ['pending', 'accepted', 'rejected', 'removed', 'cancelled']
        && (!('hostWhatsapp' in data) || (data.hostWhatsapp is string && data.hostWhatsapp.size() <= 32))
        && (!('agencyWhatsapp' in data) || (data.agencyWhatsapp is string && data.agencyWhatsapp.size() <= 32))
        && (!('message' in data) || (data.message is string && data.message.size() <= 400))
        && (!('dealCommissionPercent' in data) || (data.dealCommissionPercent is number && data.dealCommissionPercent >= 0 && data.dealCommissionPercent <= 100))
        && (!('dealTargetCoins' in data) || (data.dealTargetCoins is number && data.dealTargetCoins >= 0 && data.dealTargetCoins <= 2000000000))
        && (!('dealTargetHours' in data) || (data.dealTargetHours is number && data.dealTargetHours >= 0 && data.dealTargetHours <= 744))
        && (!('dealNotes' in data) || (data.dealNotes is string && data.dealNotes.size() <= 300));
    }

    match /agency_host_requests/{requestId} {
      allow get: if isSignedIn()
                 && isValidId(requestId)
                 && (
                   resource.data.hostUid == request.auth.uid
                   || resource.data.agencyOwnerUid == request.auth.uid
                   || isAdmin()
                 );
      allow list: if isSignedIn()
                  && (
                    resource.data.hostUid == request.auth.uid
                    || resource.data.agencyOwnerUid == request.auth.uid
                    || isAdmin()
                  );
      allow create: if isSignedIn()
                    && isValidId(requestId)
                    && isValidHostAgencyRequest(incoming())
                    && incoming().hostUid == request.auth.uid
                    && incoming().status == 'pending'
                    && exists(/databases/$(database)/documents/agencies/$(incoming().agencyId))
                    && get(/databases/$(database)/documents/agencies/$(incoming().agencyId)).data.agencyType == 'host_agency'
                    && get(/databases/$(database)/documents/agencies/$(incoming().agencyId)).data.status == 'active'
                    && get(/databases/$(database)/documents/agencies/$(incoming().agencyId)).data.ownerUid == incoming().agencyOwnerUid;
      allow update: if isSignedIn()
                    && isValidId(requestId)
                    && isValidHostAgencyRequest(incoming())
                    && incoming().agencyId == existing().agencyId
                    && incoming().agencyOwnerUid == existing().agencyOwnerUid
                    && incoming().hostUid == existing().hostUid
                    && (
                      isAdmin()
                      || existing().agencyOwnerUid == request.auth.uid
                      || (
                        existing().hostUid == request.auth.uid
                        && existing().status == 'pending'
                        && incoming().status in ['pending', 'cancelled']
                        && incoming().diff(existing()).affectedKeys().hasOnly([
                          'status', 'hostWhatsapp', 'message', 'updatedAt'
                        ])
                      )
                    );
      allow delete: if isAdmin() && isValidId(requestId);
    }

    function isValidAgencyCoinOrder(data) {
      return data.keys().hasAll([
          'agencyId', 'agencyName', 'agencyOwnerUid', 'buyerUid', 'buyerName',
          'coinsRequested', 'paymentMethod', 'status'
        ])
        && data.agencyId is string && data.agencyId.size() > 0 && data.agencyId.size() <= 140
        && data.agencyName is string && data.agencyName.size() > 0 && data.agencyName.size() <= 80
        && (!('agencyCode' in data) || (data.agencyCode is string && data.agencyCode.size() <= 24))
        && data.agencyOwnerUid is string && data.agencyOwnerUid.size() > 0 && data.agencyOwnerUid.size() <= 128
        && (!('agencyWhatsapp' in data) || (data.agencyWhatsapp is string && data.agencyWhatsapp.size() <= 32))
        && data.buyerUid is string && data.buyerUid.size() > 0 && data.buyerUid.size() <= 128
        && data.buyerName is string && data.buyerName.size() > 0 && data.buyerName.size() <= 80
        && (!('buyerUsername' in data) || (data.buyerUsername is string && data.buyerUsername.size() <= 60))
        && (!('buyerDisplayId' in data) || (data.buyerDisplayId is string && data.buyerDisplayId.size() <= 32))
        && (!('buyerAvatar' in data) || (data.buyerAvatar is string && data.buyerAvatar.size() <= 1500))
        && (!('buyerWhatsapp' in data) || (data.buyerWhatsapp is string && data.buyerWhatsapp.size() <= 32))
        && data.coinsRequested is number && data.coinsRequested > 0 && data.coinsRequested <= 2000000000
        && (!('coinsSent' in data) || (data.coinsSent is number && data.coinsSent >= 0 && data.coinsSent <= 2000000000))
        && (!('paidAmountText' in data) || (data.paidAmountText is string && data.paidAmountText.size() <= 60))
        && data.paymentMethod is string && data.paymentMethod.size() > 0 && data.paymentMethod.size() <= 40
        && (!('transactionRef' in data) || (data.transactionRef is string && data.transactionRef.size() <= 120))
        && (!('paymentSlipUrl' in data) || (data.paymentSlipUrl is string && data.paymentSlipUrl.size() <= 350000))
        && (!('buyerNote' in data) || (data.buyerNote is string && data.buyerNote.size() <= 300))
        && (!('sellerNote' in data) || (data.sellerNote is string && data.sellerNote.size() <= 300))
        && (!('confirmedTransferId' in data) || (data.confirmedTransferId is string && data.confirmedTransferId.size() <= 128))
        && data.status in ['pending', 'confirmed', 'rejected', 'cancelled'];
    }

    // Payment slips & coin purchase orders: private to buyer, target Coin Seller Agency owner, and admin
    match /agency_coin_orders/{orderId} {
      allow get: if isSignedIn()
                 && isValidId(orderId)
                 && (
                   resource.data.buyerUid == request.auth.uid
                   || resource.data.agencyOwnerUid == request.auth.uid
                   || isAdmin()
                 );
      allow list: if isSignedIn()
                  && (
                    resource.data.buyerUid == request.auth.uid
                    || resource.data.agencyOwnerUid == request.auth.uid
                    || isAdmin()
                  );
      allow create: if isSignedIn()
                    && isValidId(orderId)
                    && isValidAgencyCoinOrder(incoming())
                    && incoming().buyerUid == request.auth.uid
                    && incoming().status == 'pending'
                    && exists(/databases/$(database)/documents/agencies/$(incoming().agencyId))
                    && get(/databases/$(database)/documents/agencies/$(incoming().agencyId)).data.agencyType == 'coin_seller'
                    && get(/databases/$(database)/documents/agencies/$(incoming().agencyId)).data.status == 'active'
                    && get(/databases/$(database)/documents/agencies/$(incoming().agencyId)).data.ownerUid == incoming().agencyOwnerUid;
      allow update: if isSignedIn()
                    && isValidId(orderId)
                    && isValidAgencyCoinOrder(incoming())
                    && incoming().agencyId == existing().agencyId
                    && incoming().agencyOwnerUid == existing().agencyOwnerUid
                    && incoming().buyerUid == existing().buyerUid
                    && (
                      isAdmin()
                      || (
                        existing().agencyOwnerUid == request.auth.uid
                        && existing().status == 'pending'
                        && incoming().diff(existing()).affectedKeys().hasOnly([
                          'status', 'coinsSent', 'sellerNote', 'confirmedTransferId', 'updatedAt'
                        ])
                        && (
                          incoming().status == 'rejected'
                          || (
                            incoming().status == 'confirmed'
                            && incoming().coinsSent is number
                            && incoming().coinsSent > 0
                            && isVerifiedCoinSellerAgencyTransfer(incoming().coinsSent)
                          )
                        )
                      )
                      || (
                        existing().buyerUid == request.auth.uid
                        && existing().status == 'pending'
                        && incoming().status == 'cancelled'
                        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                      )
                    );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // ========================================================
    // 25. ADMIN DEVICE BAN REGISTRY (/banned_devices/{deviceId})
    // ========================================================
    function isValidBannedDevice(data, deviceId) {
      return data.keys().hasAll(['deviceId', 'reason', 'bannedBy', 'bannedAt', 'active'])
        && data.keys().hasOnly([
          'deviceId', 'targetUid', 'targetUserName', 'targetUserEmail',
          'reason', 'bannedBy', 'bannedAt', 'active'
        ])
        && data.deviceId == deviceId
        && data.deviceId is string && data.deviceId.size() >= 6 && data.deviceId.size() <= 128
        && (!('targetUid' in data) || (data.targetUid is string && data.targetUid.size() <= 128))
        && (!('targetUserName' in data) || (data.targetUserName is string && data.targetUserName.size() <= 80))
        && (!('targetUserEmail' in data) || (data.targetUserEmail is string && data.targetUserEmail.size() <= 120))
        && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 300
        && data.bannedBy is string && data.bannedBy.size() > 0 && data.bannedBy.size() <= 120
        && data.bannedAt is string && data.bannedAt.size() > 0 && data.bannedAt.size() <= 64
        && data.active is bool;
    }

    match /banned_devices/{deviceId} {
      // Signed-in clients can check ONLY their exact deviceId doc for live lockout; listing and mutations are strictly Admin-only
      allow get: if isSignedIn() && isValidId(deviceId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(deviceId) && isValidBannedDevice(incoming(), deviceId);
      allow delete: if isAdmin() && isValidId(deviceId);
    }
  }
}
