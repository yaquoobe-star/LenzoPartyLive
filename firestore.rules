rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================================
    // GLOBAL SECURITY PRIMITIVES
    // ========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'yaquoobe@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ========================================================
    // 0. ADMINS COLLECTION (/admins/{uid})
    // ========================================================
    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ========================================================
    // 1. USERS COLLECTION (/users/{uid})
    // ========================================================
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'authProvider', 'accountStatus'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 60
        && data.email is string && data.email.size() <= 120
        && data.authProvider in ['google', 'password']
        && data.accountStatus in ['active', 'suspended', 'pending']
        && (!('username' in data) || (data.username is string && data.username.size() <= 40))
        && (!('displayId' in data) || (data.displayId is string && data.displayId.size() <= 32))
        && (!('profileImage' in data) || (data.profileImage is string && data.profileImage.size() <= 1500))
        && (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 1500))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && (!('gender' in data) || (data.gender is string && data.gender.size() <= 24))
        && (!('country' in data) || (data.country is string && data.country.size() <= 64))
        && (!('birthday' in data) || (data.birthday is string && data.birthday.size() <= 32))
        && (!('followersCount' in data) || (data.followersCount is number && data.followersCount >= 0))
        && (!('followingCount' in data) || (data.followingCount is number && data.followingCount >= 0))
        && (!('level' in data) || (data.level is number && data.level >= 0 && data.level <= 100))
        && (!('coins' in data) || (data.coins is number && data.coins >= 0))
        && (!('diamonds' in data) || (data.diamonds is number && data.diamonds >= 0))
        && (!('totalQualifyingCoinsSpent' in data) || (data.totalQualifyingCoinsSpent is number && data.totalQualifyingCoinsSpent >= 0 && data.totalQualifyingCoinsSpent <= 2000000000))
        && (!('vipLevel' in data) || (data.vipLevel is number && data.vipLevel >= 0 && data.vipLevel <= 12))
        && (!('superVipLevel' in data) || (data.superVipLevel is number && data.superVipLevel >= 0 && data.superVipLevel <= 6))
        && (!('equippedVipFrame' in data) || (data.equippedVipFrame is number && data.equippedVipFrame >= 0 && data.equippedVipFrame <= 12))
        && (!('equippedSuperVipFrame' in data) || (data.equippedSuperVipFrame is number && data.equippedSuperVipFrame >= 0 && data.equippedSuperVipFrame <= 6))
        && (!('activeFrameType' in data) || data.activeFrameType in ['none', 'vip', 'super_vip'])
        && (!('equippedBadges' in data) || (data.equippedBadges is list && data.equippedBadges.size() <= 3))
        && (!('isVIP' in data) || data.isVIP is bool)
        && (!('isSuperVIP' in data) || data.isSuperVIP is bool)
        && (!('isVerified' in data) || data.isVerified is bool)
        && (!('verificationTier' in data) || data.verificationTier in ['none', 'blue', 'gold'])
        && (!('verifiedTag' in data) || (data.verifiedTag is string && data.verifiedTag.size() <= 32))
        && (!('isOnline' in data) || data.isOnline is bool);
    }

    match /users/{uid} {
      // Authenticated users can view creator profiles; list restricted to owner or admin
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // Only the authenticated user can create their own profile document
      allow create: if isOwner(uid)
                    && isValidId(uid)
                    && incoming().uid == request.auth.uid
                    && incoming().accountStatus == 'active'
                    && isValidUser(incoming());

      // Action-partitioned updates:
      // 1) Owner updating their own profile with immutable core identity fields
      // 2) Authenticated gifter crediting recipient's diamonds balance upward only
      // 3) Admin override
      allow update: if isSignedIn() && isValidId(uid) && isValidUser(incoming()) && (
                      isAdmin()
                      || (
                        isOwner(uid)
                        && incoming().uid == existing().uid
                        && incoming().email == existing().email
                        && incoming().authProvider == existing().authProvider
                        && incoming().accountStatus == existing().accountStatus
                      )
                      || (
                        incoming().diff(existing()).affectedKeys().hasOnly(['diamonds'])
                        && incoming().diamonds is number
                        && (!('diamonds' in existing()) || incoming().diamonds >= existing().diamonds)
                      )
                    );

      allow delete: if false;

      // User Transactions subcollection
      match /transactions/{transactionId} {
        allow get: if (isOwner(uid) || isAdmin()) && isValidId(transactionId);
        allow list: if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) || isAdmin())
                      && isValidId(transactionId)
                      && incoming().userId == uid;
        allow update, delete: if false;
      }

      // User Notifications subcollection
      match /notifications/{notificationId} {
        allow get: if (isOwner(uid) || isAdmin()) && isValidId(notificationId);
        allow list: if isOwner(uid) || isAdmin();
        allow create: if isSignedIn()
                      && isValidId(notificationId)
                      && incoming().title is string && incoming().title.size() <= 120
                      && incoming().message is string && incoming().message.size() <= 400
                      && incoming().type in ['system', 'like', 'follow', 'gift']
                      && incoming().isRead == false;
        allow update: if (isOwner(uid) || isAdmin())
                      && isValidId(notificationId)
                      && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
                      && incoming().isRead is bool;
        allow delete: if (isOwner(uid) || isAdmin()) && isValidId(notificationId);
      }
    }

    // ========================================================
    // 2. POSTS / VIDEOS COLLECTION (/posts/{postId})
    // ========================================================
    function isValidPost(data) {
      return data.keys().hasAll(['userId', 'videoUrl'])
        && data.userId is string && data.userId.size() <= 128
        && data.videoUrl is string && data.videoUrl.size() <= 1500
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1500))
        && (!('musicTitle' in data) || (data.musicTitle is string && data.musicTitle.size() <= 150))
        && (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0))
        && (!('sharesCount' in data) || (data.sharesCount is number && data.sharesCount >= 0))
        && (!('isPrivate' in data) || data.isPrivate is bool);
    }

    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(postId)
                    && incoming().userId == request.auth.uid
                    && isValidPost(incoming());
      allow update: if isSignedIn()
                    && isValidId(postId)
                    && isValidPost(incoming())
                    && (
                      isAdmin()
                      || (existing().userId == request.auth.uid && incoming().userId == existing().userId)
                      || incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'sharesCount', 'commentsCount'])
                    );
      allow delete: if isSignedIn() && isValidId(postId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // ========================================================
    // 3. PARTY ROOMS COLLECTION (/party_rooms/{roomId})
    // ========================================================
    match /party_rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(roomId)
                    && incoming().host.id == request.auth.uid;
      allow update: if isSignedIn()
                    && isValidId(roomId)
                    && (
                      isAdmin()
                      || (existing().host.id == request.auth.uid && incoming().host.id == existing().host.id)
                      || incoming().diff(existing()).affectedKeys().hasOnly(['seats', 'seatRequests', 'viewersCount', 'numericParticipants', 'participantCount', 'likesCount'])
                    );
      allow delete: if isSignedIn() && isValidId(roomId) && (existing().host.id == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId);
        allow list: if isSignedIn() && isValidId(roomId);
        allow create: if isSignedIn()
                      && isValidId(roomId)
                      && isValidId(messageId)
                      && exists(/databases/$(database)/documents/party_rooms/$(roomId))
                      && incoming().userId == request.auth.uid
                      && incoming().text is string
                      && incoming().text.size() > 0
                      && incoming().text.size() <= 500;
        allow update: if false;
        allow delete: if isSignedIn()
                      && isValidId(roomId)
                      && isValidId(messageId)
                      && (
                        existing().userId == request.auth.uid
                        || get(/databases/$(database)/documents/party_rooms/$(roomId)).data.host.id == request.auth.uid
                        || isAdmin()
                      );
      }

      match /participants/{participantId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(participantId);
        allow list: if isSignedIn() && isValidId(roomId);
        allow create, update: if isSignedIn()
                              && isValidId(roomId)
                              && isValidId(participantId)
                              && exists(/databases/$(database)/documents/party_rooms/$(roomId))
                              && (
                                participantId == request.auth.uid
                                || get(/databases/$(database)/documents/party_rooms/$(roomId)).data.host.id == request.auth.uid
                                || isAdmin()
                              )
                              && incoming().userId is string
                              && incoming().userId.size() <= 128;
        allow delete: if isSignedIn()
                      && isValidId(roomId)
                      && isValidId(participantId)
                      && (
                        participantId == request.auth.uid
                        || get(/databases/$(database)/documents/party_rooms/$(roomId)).data.host.id == request.auth.uid
                        || isAdmin()
                      );
      }
    }

    // ========================================================
    // 4. LIVE STREAMS COLLECTION (/live_streams/{streamId})
    // ========================================================
    match /live_streams/{streamId} {
      allow get: if isSignedIn() && isValidId(streamId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(streamId)
                    && incoming().host.id == request.auth.uid;
      allow update: if isSignedIn()
                    && isValidId(streamId)
                    && (
                      isAdmin()
                      || (existing().host.id == request.auth.uid && incoming().host.id == existing().host.id)
                      || incoming().diff(existing()).affectedKeys().hasOnly(['viewersCount', 'numericViewers', 'viewerCount', 'likesCount', 'commentsCount'])
                    );
      allow delete: if isSignedIn() && isValidId(streamId) && (existing().host.id == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(streamId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(streamId);
        allow create: if isSignedIn()
                      && isValidId(streamId)
                      && isValidId(commentId)
                      && exists(/databases/$(database)/documents/live_streams/$(streamId))
                      && incoming().userId == request.auth.uid
                      && incoming().text is string
                      && incoming().text.size() > 0
                      && incoming().text.size() <= 500;
        allow update: if false;
        allow delete: if isSignedIn()
                      && isValidId(streamId)
                      && isValidId(commentId)
                      && (
                        existing().userId == request.auth.uid
                        || get(/databases/$(database)/documents/live_streams/$(streamId)).data.host.id == request.auth.uid
                        || isAdmin()
                      );
      }

      match /viewers/{viewerId} {
        allow get: if isSignedIn() && isValidId(streamId) && isValidId(viewerId);
        allow list: if isSignedIn() && isValidId(streamId);
        allow create, update: if isSignedIn()
                              && isValidId(streamId)
                              && isValidId(viewerId)
                              && exists(/databases/$(database)/documents/live_streams/$(streamId))
                              && (
                                viewerId == request.auth.uid
                                || get(/databases/$(database)/documents/live_streams/$(streamId)).data.host.id == request.auth.uid
                                || isAdmin()
                              )
                              && incoming().userId is string
                              && incoming().userId.size() <= 128;
        allow delete: if isSignedIn()
                      && isValidId(streamId)
                      && isValidId(viewerId)
                      && (
                        viewerId == request.auth.uid
                        || get(/databases/$(database)/documents/live_streams/$(streamId)).data.host.id == request.auth.uid
                        || isAdmin()
                      );
      }
    }

    // ========================================================
    // 5. CHATS & CONVERSATIONS (/chats/{chatId})
    // ========================================================
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(chatId);
      allow update: if isSignedIn() && isValidId(chatId);
      allow delete: if isAdmin() && isValidId(chatId);

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(messageId);
        allow list: if isSignedIn() && isValidId(chatId);
        allow create: if isSignedIn()
                      && isValidId(chatId)
                      && isValidId(messageId)
                      && incoming().senderId == request.auth.uid
                      && (!('text' in incoming()) || (incoming().text is string && incoming().text.size() <= 2000));
        allow update: if isSignedIn()
                      && isValidId(chatId)
                      && isValidId(messageId)
                      && (
                        isAdmin()
                        || existing().senderId == request.auth.uid
                        || incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'isPinned', 'isStarred', 'deletedForUsers', 'status'])
                      );
        allow delete: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    // ========================================================
    // 6. GROUPS COLLECTION (/groups/{groupId})
    // ========================================================
    match /groups/{groupId} {
      allow get: if isSignedIn() && isValidId(groupId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(groupId)
                    && incoming().creatorId == request.auth.uid
                    && incoming().name is string && incoming().name.size() <= 100;
      allow update: if isSignedIn()
                    && isValidId(groupId)
                    && (
                      isAdmin()
                      || existing().creatorId == request.auth.uid
                      || incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'membersCount', 'lastMessage', 'lastMessageTime', 'updatedAt'])
                    );
      allow delete: if isSignedIn() && isValidId(groupId) && (existing().creatorId == request.auth.uid || isAdmin());
    }

    // ========================================================
    // 7. WALLETS COLLECTION (/wallets/{uid}) — OWNER & ADMIN ONLY
    // ========================================================
    function isValidWallet(data) {
      return data.keys().hasAll(['userId', 'walletPurchasedCoins'])
        && data.userId is string && data.userId.size() <= 128
        && data.walletPurchasedCoins is number && data.walletPurchasedCoins >= 0
        && (!('totalCoinsPurchased' in data) || (data.totalCoinsPurchased is number && data.totalCoinsPurchased >= 0))
        && (!('totalCoinsSpent' in data) || (data.totalCoinsSpent is number && data.totalCoinsSpent >= 0));
    }

    match /wallets/{uid} {
      allow get: if (isOwner(uid) || isAdmin()) && isValidId(uid);
      allow list: if (isOwner(uid) || isAdmin());
      allow create: if isValidId(uid)
                    && isValidWallet(incoming())
                    && (isAdmin() || (isOwner(uid) && incoming().userId == request.auth.uid));
      allow update: if isValidId(uid)
                    && isValidWallet(incoming())
                    && (
                      isAdmin()
                      || (isOwner(uid) && incoming().userId == existing().userId)
                    );
      allow delete: if false;
    }

    // ========================================================
    // 8. EARNINGS COLLECTION (/earnings/{uid})
    // ========================================================
    function isValidEarnings(data) {
      return data.userId is string && data.userId.size() <= 128
        && (!('availableEarningsCoins' in data) || (data.availableEarningsCoins is number && data.availableEarningsCoins >= 0))
        && (!('pendingWithdrawalCoins' in data) || (data.pendingWithdrawalCoins is number && data.pendingWithdrawalCoins >= 0))
        && (!('totalWithdrawnCoins' in data) || (data.totalWithdrawnCoins is number && data.totalWithdrawnCoins >= 0))
        && (!('grossGiftCoinsReceived' in data) || (data.grossGiftCoinsReceived is number && data.grossGiftCoinsReceived >= 0))
        && (!('totalCommissionDeducted' in data) || (data.totalCommissionDeducted is number && data.totalCommissionDeducted >= 0))
        && (!('totalConvertedToWallet' in data) || (data.totalConvertedToWallet is number && data.totalConvertedToWallet >= 0))
        && (!('totalGiftsCount' in data) || (data.totalGiftsCount is number && data.totalGiftsCount >= 0));
    }

    match /earnings/{uid} {
      // Signed-in get allowed for atomic gift credit runTransaction; list restricted to owner/admin
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && isValidId(uid) && isValidEarnings(incoming()) && (
                      isAdmin()
                      || (isOwner(uid) && incoming().userId == request.auth.uid)
                      || (
                        // Initial earnings record created when another user sends the first gift
                        incoming().userId == uid
                        && (!('pendingWithdrawalCoins' in incoming()) || incoming().pendingWithdrawalCoins == 0)
                        && (!('totalWithdrawnCoins' in incoming()) || incoming().totalWithdrawnCoins == 0)
                        && (!('totalConvertedToWallet' in incoming()) || incoming().totalConvertedToWallet == 0)
                      )
                    );

      allow update: if isSignedIn() && isValidId(uid) && isValidEarnings(incoming()) && (
                      isAdmin()
                      || (
                        // Owner converting earnings to wallet or reserving pending withdrawal coins
                        isOwner(uid)
                        && incoming().userId == existing().userId
                        && (!('totalWithdrawnCoins' in existing()) || incoming().totalWithdrawnCoins == existing().totalWithdrawnCoins)
                        && incoming().availableEarningsCoins <= existing().availableEarningsCoins
                      )
                      || (
                        // Gifter crediting recipient upward only; cannot touch pending/withdrawn/converted totals
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'userId',
                          'availableEarningsCoins',
                          'grossGiftCoinsReceived',
                          'totalCommissionDeducted',
                          'totalGiftsCount',
                          'updatedAt'
                        ])
                        && incoming().availableEarningsCoins >= existing().availableEarningsCoins
                      )
                    );

      allow delete: if false;
    }

    // ========================================================
    // 9. FINANCIAL TRANSACTIONS COLLECTIONS (IMMUTABLE AUDIT LOGS)
    // ========================================================
    match /wallet_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(txId)
                    && (incoming().userId == request.auth.uid || isAdmin())
                    && incoming().amount is number;
      allow update, delete: if false;
    }

    match /earnings_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(txId)
                    && incoming().amount is number
                    && (
                      incoming().userId == request.auth.uid
                      || isAdmin()
                      || (incoming().category == 'gift_received' && incoming().metadata.senderId == request.auth.uid)
                    );
      allow update, delete: if false;
    }

    match /commission_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (resource.data.senderId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(txId)
                    && (incoming().senderId == request.auth.uid || isAdmin())
                    && incoming().grossCost is number && incoming().grossCost > 0
                    && incoming().commissionCoins is number && incoming().commissionCoins >= 0;
      allow update, delete: if false;
    }

    // ========================================================
    // 10. WITHDRAWAL REQUESTS (/withdrawal_requests/{reqId}) — STRICT PII + ADMIN APPROVAL
    // ========================================================
    function isValidWithdrawalRequest(data) {
      return data.keys().hasAll(['userId', 'coinsRequested', 'paymentMethod', 'status'])
        && data.userId is string && data.userId.size() <= 128
        && data.coinsRequested is number && data.coinsRequested > 0
        && data.paymentMethod in ['bank_transfer', 'jazzcash', 'easypaisa', 'cash_pickup']
        && data.status in ['pending', 'under_review', 'approved', 'processing', 'paid', 'rejected', 'cancelled'];
    }

    match /withdrawal_requests/{reqId} {
      allow get: if isSignedIn() && isValidId(reqId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(reqId)
                    && incoming().userId == request.auth.uid
                    && incoming().status == 'pending'
                    && isValidWithdrawalRequest(incoming());
      allow update: if isSignedIn()
                    && isValidId(reqId)
                    && isValidWithdrawalRequest(incoming())
                    && isAdmin();
      allow delete: if false;
    }

    // ========================================================
    // 11. WALLET SETTINGS & RECHARGE PACKAGES — ADMIN WRITE ONLY
    // ========================================================
    match /wallet_settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(settingId);
      allow delete: if false;
    }

    match /coin_packages/{pkgId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(pkgId);
      allow delete: if false;
    }

    // ========================================================
    // 12. 100-LEVEL, 12-VIP, 6-SUPER-VIP & ACHIEVEMENT PROGRESSION SYSTEM
    // ========================================================
    function isValidUserLevel(data) {
      return data.keys().hasAll(['userId', 'currentLevel', 'totalQualifyingCoinsSpent'])
        && data.userId is string && data.userId.size() <= 128
        && data.currentLevel is number && data.currentLevel >= 0 && data.currentLevel <= 100
        && data.totalQualifyingCoinsSpent is number && data.totalQualifyingCoinsSpent >= 0 && data.totalQualifyingCoinsSpent <= 2000000000
        && (!('vipLevel' in data) || (data.vipLevel is number && data.vipLevel >= 0 && data.vipLevel <= 12))
        && (!('superVipLevel' in data) || (data.superVipLevel is number && data.superVipLevel >= 0 && data.superVipLevel <= 6))
        && (!('equippedVipFrame' in data) || (data.equippedVipFrame is number && data.equippedVipFrame >= 0 && data.equippedVipFrame <= 12))
        && (!('equippedSuperVipFrame' in data) || (data.equippedSuperVipFrame is number && data.equippedSuperVipFrame >= 0 && data.equippedSuperVipFrame <= 6))
        && (!('activeFrameType' in data) || data.activeFrameType in ['none', 'vip', 'super_vip'])
        && (!('unlockedVipTiers' in data) || (data.unlockedVipTiers is list && data.unlockedVipTiers.size() <= 12))
        && (!('unlockedSuperVipTiers' in data) || (data.unlockedSuperVipTiers is list && data.unlockedSuperVipTiers.size() <= 6))
        && (!('equippedAchievementBadges' in data) || (data.equippedAchievementBadges is list && data.equippedAchievementBadges.size() <= 3));
    }

    match /user_levels/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(uid)
                    && isValidUserLevel(incoming())
                    && (isAdmin() || (isOwner(uid) && incoming().userId == request.auth.uid));
      allow update: if isValidId(uid)
                    && isValidUserLevel(incoming())
                    && (isAdmin() || (isOwner(uid) && incoming().userId == existing().userId));
      allow delete: if false;
    }

    match /level_configurations/{docId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(docId);
      allow delete: if false;
    }

    match /vip_frames/{docId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(docId);
      allow delete: if false;
    }

    match /super_vip_frames/{docId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(docId);
      allow delete: if false;
    }

    match /achievement_definitions/{docId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(docId);
      allow delete: if false;
    }

    match /progression_audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
                    && isValidId(logId)
                    && incoming().adminEmail is string
                    && incoming().action is string
                    && incoming().reason is string;
      allow update, delete: if false;
    }

    // ========================================================
    // 13. FOLLOWS GRAPH (/follows/{followId})
    // ========================================================
    match /follows/{followId} {
      allow get: if isSignedIn() && isValidId(followId);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(followId)
                    && incoming().followerId == request.auth.uid
                    && incoming().followingId is string
                    && incoming().followingId.size() > 0
                    && incoming().followingId.size() <= 128
                    && incoming().followingId != request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn()
                    && isValidId(followId)
                    && (existing().followerId == request.auth.uid || isAdmin());
    }

    // ========================================================
    // 14. BROADCASTER RANKING CONFIG (/ranking_configs/{configId})
    // ========================================================
    match /ranking_configs/{configId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin()
                            && isValidId(configId)
                            && incoming().viewerWeight is number
                            && incoming().giftWeight is number
                            && incoming().engagementWeight is number
                            && incoming().durationWeight is number;
      allow delete: if false;
    }

    // ========================================================
    // 15. LENZO PARTY STORE (store_categories, store_products, user_inventory, coin_transactions)
    // ========================================================
    function isValidStoreCategoryId(catId) {
      return catId in ['vip_frames', 'special_entry', 'custom_gift', 'premium_assets'];
    }

    function isValidStoreCategory(data) {
      return data.keys().hasAll(['id', 'title', 'enabled'])
        && isValidStoreCategoryId(data.id)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 64
        && data.enabled is bool
        && (!('order' in data) || (data.order is number && data.order >= 0 && data.order <= 100));
    }

    function isValidStoreProduct(data) {
      return data.keys().hasAll(['name', 'categoryId', 'priceCoins', 'enabled'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 64
        && isValidStoreCategoryId(data.categoryId)
        && data.priceCoins is number && data.priceCoins >= 1 && data.priceCoins <= 100000000
        && data.enabled is bool
        && (!('description' in data) || (data.description is string && data.description.size() <= 320))
        && (!('isFeatured' in data) || data.isFeatured is bool)
        && (!('sortOrder' in data) || (data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000));
    }

    function isValidUserInventoryItem(data) {
      return data.keys().hasAll(['userId', 'productId', 'categoryId', 'pricePaidCoins', 'equipped'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128
        && isValidStoreCategoryId(data.categoryId)
        && data.pricePaidCoins is number && data.pricePaidCoins >= 0 && data.pricePaidCoins <= 100000000
        && data.equipped is bool;
    }

    function isValidCoinTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'balanceBefore', 'balanceAfter', 'idempotencyKey', 'status'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.type in ['store_purchase', 'coin_recharge', 'admin_adjustment']
        && data.amount is number
        && data.balanceBefore is number && data.balanceBefore >= 0
        && data.balanceAfter is number && data.balanceAfter >= 0
        && data.idempotencyKey is string && data.idempotencyKey.size() > 0 && data.idempotencyKey.size() <= 160
        && data.status in ['completed', 'failed'];
    }

    match /store_categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin()
                            && isValidId(categoryId)
                            && isValidStoreCategoryId(categoryId)
                            && isValidStoreCategory(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /store_products/{productId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin()
                            && isValidId(productId)
                            && isValidStoreProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /user_inventory/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(itemId)
                    && isValidUserInventoryItem(incoming())
                    && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn()
                    && isValidId(itemId)
                    && isValidUserInventoryItem(incoming())
                    && (
                      isAdmin()
                      || (
                        existing().userId == request.auth.uid
                        && incoming().userId == existing().userId
                        && incoming().productId == existing().productId
                        && incoming().categoryId == existing().categoryId
                        && incoming().pricePaidCoins == existing().pricePaidCoins
                      )
                    );
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /coin_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(txId)
                    && isValidCoinTransaction(incoming())
                    && (incoming().userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }
  }
}

